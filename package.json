{
  "name": "m3-companysite",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "M3MM marketing site — Astro + Tailwind on Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run resume:pdf && astro build && npm run verify:dist",
    "verify:dist": "node scripts/check-shipped-placeholders.mjs dist functions",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:canonicals": "node scripts/audit-canonicals.mjs",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@astrojs/check": "^0.9.9",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.18.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "sharp": "^0.35.2",
    "astro": {
      "esbuild": "^0.28.1"
    }
  }
}
