{
  "name": "m3-companysite",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "M3MM marketing site — Astro + Tailwind on Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run resume:pdf && astro build && node scripts/build-investors.mjs && node scripts/csp-script-hashes.mjs dist && npm run verify:dist",
    "deploy": "node scripts/deploy-pages.mjs",
    "verify:dist": "node scripts/check-shipped-placeholders.mjs dist functions && node scripts/check-internal-links.mjs dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:canonicals": "node scripts/audit-canonicals.mjs",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs",
    "test:a11y": "node scripts/axe-home.mjs",
    "test:a11y:all": "node scripts/axe-all.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@astrojs/check": "^0.9.10",
    "astro": "^7.4.13",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "playwright": "1.61.1",
    "puppeteer-core": "^25.18.1",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
