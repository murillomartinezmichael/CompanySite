---
import Layout from '@/layouts/Layout.astro';
import { tradeServiceJsonLd } from '@/lib/tradeServiceJsonLd';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TradeLanding from '@/components/TradeLanding.astro';
import Intake from '@/components/Intake.astro';
---

<Layout
  title="Websites for roofing contractors in Metro Atlanta — M3MM"
  description="Roofing contractor websites in Metro Atlanta that make services, project photos, qualifications and inspection requests easy to find. Get a free video teardown."
  path="/for/roofing"
  extraJsonLd={tradeServiceJsonLd('roofing')}
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'For roofing contractors', url: '/for/roofing' },
  ]}
>
  <Header slot="header" minimal={true} path="/for/roofing" />

  <TradeLanding
    trade="roofing"
    kicker="For roofing contractors"
    headline="A roofing website built to earn"
    headlineDim="the next inquiry."
    sub="When a homeowner needs a roof inspected, repaired, or replaced, they need to know what you handle and how to reach you. Show your service area, roofing materials, completed project photos, and applicable licensing and insurance clearly, with a straightforward path to request an inspection or quote."
    proofs={[
      {
        name: 'Aries Outdoor Living',
        accent: 'cyber',
        pre: 'Related contractor work:',
        strong: 'a gallery-first site',
        post: ' that puts completed projects in view.',
      },
    ]}
  />

  <section class="container-page py-16" aria-labelledby="atlanta-homeowners">
    <h2 id="atlanta-homeowners" class="text-3xl font-display">What Atlanta homeowners check first</h2>
    <ul class="mt-6 space-y-4">
      <li><strong>Roofing services:</strong> Show whether you handle inspections, repairs, replacements, and the roofing materials you work with.</li>
      <li><strong>Project photos:</strong> Share clear photos of completed roofing work so homeowners can see what you do.</li>
      <li><strong>Service area:</strong> List the metro counties you actually serve, such as Fulton, DeKalb, Cobb, or Gwinnett.</li>
      <li><strong>Contact options:</strong> Make your phone number and inspection or quote request options easy to find on a mobile device.</li>
    </ul>
    <p class="mt-6">Georgia has no roofing-specific state license. Residential and general contractors are licensed by the State Licensing Board for Residential and General Contractors under the Georgia Secretary of State. Cities and counties commonly require a local business license or occupational tax certificate. Show your license number so customers can <a class="m3-link" href="https://verify.sos.ga.gov" target="_blank" rel="noopener" data-cta="roofing-verify-license" data-section="for-roofing">verify a Georgia license</a>.</p>
  </section>

  <Intake
    eyebrow="Step 1 · Tell me what to look at"
    headline="What should customers know about your roofing business?"
    sub="Share your current site and what is getting in the way, or tell me how customers reach you today. I will review how your roofing services, project work, and inspection or quote request are presented in a free video teardown."
    source="for-roofing"
  />

  <Footer slot="footer" path="/for/roofing" />
</Layout>
