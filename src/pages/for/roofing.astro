---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TradeLanding from '@/components/TradeLanding.astro';
import Intake from '@/components/Intake.astro';
---

<Layout
  title="Websites for roofing contractors — M3MM"
  description="Roofing contractor websites that make services, project photos, qualifications and inspection requests easy to find. Get a free video teardown."
  path="/for/roofing"
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'For roofing contractors', url: '/for/roofing' },
  ]}
>
  <Header slot="header" minimal={true} path="/for/roofing" />

  <TradeLanding
    trade="roofing"
    kicker="For roofing contractors"
    headline="A roofing website built to earn"
    headlineDim="the next inquiry."
    sub="When a homeowner needs a roof inspected, repaired, or replaced, they need to know what you handle and how to reach you. Show your service area, roofing materials, completed project photos, and applicable licensing and insurance clearly, with a straightforward path to request an inspection or quote."
    proofs={[
      {
        name: 'Aries Outdoor Living',
        accent: 'cyber',
        pre: 'Related contractor work:',
        strong: 'a gallery-first site',
        post: ' that puts completed projects in view.',
      },
    ]}
  />

  <Intake
    eyebrow="Step 1 · Tell me what to look at"
    headline="What should customers know about your roofing business?"
    sub="Share your current site and what is getting in the way, or tell me how customers reach you today. I will review how your roofing services, project work, and inspection or quote request are presented in a free video teardown."
    source="for-roofing"
  />

  <Footer slot="footer" path="/for/roofing" />
</Layout>
