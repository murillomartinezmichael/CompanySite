---
import Layout from '@/layouts/Layout.astro';
import { tradeServiceJsonLd } from '@/lib/tradeServiceJsonLd';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TradeLanding from '@/components/TradeLanding.astro';
import Intake from '@/components/Intake.astro';
---

<Layout
  title="Websites for home-service pros in Metro Atlanta — M3MM"
  description="Websites for Metro Atlanta home-service companies that make services, service areas and booking options easy to find. Get a free video teardown of your site."
  path="/for/home-services"
  extraJsonLd={tradeServiceJsonLd('home-services')}
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'For home-service pros', url: '/for/home-services' },
  ]}
>
  <Header slot="header" minimal={true} path="/for/home-services" />

  <TradeLanding
    trade="home-services"
    kicker="For home-service pros"
    headline="Websites that get home-service pros"
    headlineDim="booked."
    sub="If your work happens at someone's house, your site has one job: turn the homeowner who found you into a booked job. That's the site I build — and the proof below is two home-service companies it already worked for."
    proofs={[
      {
        name: 'Aries Outdoor Living',
        accent: 'cyber',
        pre: 'Same intake, same 24h review.',
        strong: 'Deployed and sold',
        post: ' · first quote request 3 days after handoff.',
      },
      {
        name: 'Big 7 Construction',
        accent: 'neon',
        pre: 'Same intake.',
        strong: 'Build + Repair test deployment',
        post: ' complete · official launch waits on real jobsite photography.',
      },
    ]}
  />

  <section class="container-page py-16" aria-labelledby="atlanta-homeowners">
    <h2 id="atlanta-homeowners" class="text-3xl font-display">What Atlanta homeowners check first</h2>
    <ul class="mt-6 space-y-4">
      <li><strong>Services:</strong> List the jobs you take and the ones you don't, so homeowners know they found the right company.</li>
      <li><strong>Proof of work:</strong> Show photos of completed jobs and any reviews customers have given you permission to share.</li>
      <li><strong>Service area:</strong> List the metro counties you actually serve, such as Fulton, DeKalb, Cobb, or Gwinnett.</li>
      <li><strong>Booking:</strong> Make your phone number and request form easy to find on a mobile device.</li>
    </ul>
    <p class="mt-6">Many home-service trades in Georgia, including residential and general contracting, electrical, plumbing, and conditioned air, require a state license through the Georgia Secretary of State. Cities and counties commonly require a local business license or occupational tax certificate. If your trade is licensed, show your license number so customers can <a class="m3-link" href="https://verify.sos.ga.gov" target="_blank" rel="noopener" data-cta="home-services-verify-license" data-section="for-home-services">verify a Georgia license</a>.</p>
  </section>

  <Intake
    eyebrow="Step 1 · Tell me what to look at"
    headline="What's on your site and what's frustrating you about it?"
    sub="The more specific you are, the more useful the teardown. If you don't have a site yet, say that — I'll review the funnel you have (Instagram, phone-only, etc.) and tell you what a site would change."
    source="for-home-services"
  />

  <Footer slot="footer" path="/for/home-services" />
</Layout>
