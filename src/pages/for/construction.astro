---
import Layout from '@/layouts/Layout.astro';
import { tradeServiceJsonLd } from '@/lib/tradeServiceJsonLd';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TradeLanding from '@/components/TradeLanding.astro';
import Intake from '@/components/Intake.astro';
---

<Layout
  title="Websites for construction companies in Metro Atlanta — M3MM"
  description="Construction company websites in Metro Atlanta that make new builds, repairs, service areas and quote requests easy to find. Get a free video teardown."
  path="/for/construction"
  extraJsonLd={tradeServiceJsonLd('construction')}
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'For construction companies', url: '/for/construction' },
  ]}
>
  <Header slot="header" minimal={true} path="/for/construction" />

  <TradeLanding
    trade="construction"
    kicker="For construction companies"
    headline="Websites that get construction companies"
    headlineDim="booked."
    sub="General contractor, builder, or repair crew — the job is the same: a company site that routes every visitor into a quote request. Big 7 Construction's test deployment routes Build and Repair lanes through one intake while the official launch waits on jobsite photography."
    proofs={[
      {
        name: 'Big 7 Construction',
        accent: 'neon',
        pre: 'Same intake.',
        strong: 'Build + Repair test deployment',
        post: ' complete · official launch waits on real jobsite photography.',
      },
    ]}
  />

  <section class="container-page py-16" aria-labelledby="atlanta-property-owners">
    <h2 id="atlanta-property-owners" class="text-3xl font-display">What Atlanta property owners check first</h2>
    <ul class="mt-6 space-y-4">
      <li><strong>Services:</strong> Say plainly whether you take on new builds, additions, renovations, repairs, or a mix, and for residential or commercial clients.</li>
      <li><strong>Project photos:</strong> Show completed jobs with a short note on scope, so visitors can match your work to their project.</li>
      <li><strong>Service area:</strong> List the metro counties you actually serve, such as Fulton, DeKalb, Cobb, or Gwinnett.</li>
      <li><strong>Quote path:</strong> Make your phone number and quote request easy to find on a mobile device.</li>
    </ul>
    <p class="mt-6">In Georgia, residential and general contractors are licensed by the State Licensing Board for Residential and General Contractors under the Georgia Secretary of State. Cities and counties commonly require a local business license or occupational tax certificate. Show your license number so customers can <a class="m3-link" href="https://verify.sos.ga.gov" target="_blank" rel="noopener" data-cta="construction-verify-license" data-section="for-construction">verify a Georgia license</a>.</p>
  </section>

  <Intake
    eyebrow="Step 1 · Tell me what to look at"
    headline="What's on your site and what's frustrating you about it?"
    sub="The more specific you are, the more useful the teardown. If you don't have a site yet, say that — I'll review the funnel you have (Instagram, phone-only, etc.) and tell you what a site would change."
    source="for-construction"
  />

  <Footer slot="footer" path="/for/construction" />
</Layout>
