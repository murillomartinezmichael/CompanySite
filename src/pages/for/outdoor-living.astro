---
import Layout from '@/layouts/Layout.astro';
import { tradeServiceJsonLd } from '@/lib/tradeServiceJsonLd';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import TradeLanding from '@/components/TradeLanding.astro';
import Intake from '@/components/Intake.astro';
---

<Layout
  title="Websites for outdoor living contractors in Metro Atlanta — M3MM"
  description="Gallery-first websites for Metro Atlanta deck, patio and pergola builders that turn finished projects into quote requests. Get a free video teardown."
  path="/for/outdoor-living"
  extraJsonLd={tradeServiceJsonLd('outdoor-living')}
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'For outdoor living contractors', url: '/for/outdoor-living' },
  ]}
>
  <Header slot="header" minimal={true} path="/for/outdoor-living" />

  <TradeLanding
    trade="outdoor-living"
    kicker="For outdoor living contractors"
    headline="Websites that get outdoor living contractors"
    headlineDim="booked."
    sub="Your last finished build sells the next one. I build gallery-first sites that lead with the work — the way Aries Outdoor Living's rebuild did: deployed and sold at handoff, first quote request 3 days later."
    proofs={[
      {
        name: 'Aries Outdoor Living',
        accent: 'cyber',
        pre: 'Same intake, same 24h review.',
        strong: 'Deployed and sold',
        post: ' · first quote request 3 days after handoff.',
      },
    ]}
  />

  <section class="container-page py-16" aria-labelledby="atlanta-homeowners">
    <h2 id="atlanta-homeowners" class="text-3xl font-display">What Atlanta homeowners check first</h2>
    <ul class="mt-6 space-y-4">
      <li><strong>Finished builds:</strong> Lead with photos of completed decks, patios, pergolas, and outdoor structures.</li>
      <li><strong>What you build:</strong> Say which structures and materials you work with, so homeowners can tell if you fit their project.</li>
      <li><strong>Service area:</strong> List the metro counties you actually serve, such as Fulton, DeKalb, Cobb, or Gwinnett.</li>
      <li><strong>Quote path:</strong> Make your phone number and quote request easy to find on a mobile device.</li>
    </ul>
    <p class="mt-6">Depending on the scope of work, building decks, pergolas, and other outdoor structures in Georgia may require a residential or general contractor license from the Georgia Secretary of State, as well as local building permits. If you hold a license, show your license number so customers can <a class="m3-link" href="https://verify.sos.ga.gov" target="_blank" rel="noopener" data-cta="outdoor-living-verify-license" data-section="for-outdoor-living">verify a Georgia license</a>.</p>
  </section>

  <Intake
    eyebrow="Step 1 · Tell me what to look at"
    headline="What's on your site and what's frustrating you about it?"
    sub="The more specific you are, the more useful the teardown. If you don't have a site yet, say that — I'll review the funnel you have (Instagram, phone-only, etc.) and tell you what a site would change."
    source="for-outdoor-living"
  />

  <Footer slot="footer" path="/for/outdoor-living" />
</Layout>
