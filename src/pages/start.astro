---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Intake from '@/components/Intake.astro';
import { BASIC_SITE, HOSTING_PLAN, checkoutReady, hostingCheckoutReady } from '@/config/offers';
---

<Layout
  title={`Start your $${BASIC_SITE.priceUsd} business site — M3MM`}
  description={`Reserve an M3MM basic business-site build with a $${BASIC_SITE.depositUsd} non-refundable down payment, then send the project intake.`}
  path="/start"
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'Start a basic site', url: '/start' },
  ]}
>
  <Header slot="header" minimal={true} path="/start" />

  <div>
    <section id="deposit-step" class="page-intro relative isolate overflow-hidden py-hq-section">
      <div class="container-page">
        <div class="grid gap-12 lg:grid-cols-[1.1fr,0.9fr] lg:items-start lg:gap-20">
          <div class="max-w-3xl">
            <div class="mb-6 flex items-center gap-3">
              <span class="hairline"></span>
              <p class="kicker mono">Basic site · reserve the build</p>
            </div>

            <h1 class="text-hq-hero">
              Start your <span class="highlight-yellow"><span class="fg">${BASIC_SITE.priceUsd} site</span></span> with ${BASIC_SITE.depositUsd} down.
            </h1>
            <p class="mt-6 max-w-2xl text-lg text-bone-dim">
              {checkoutReady
                ? `Pay the ${BASIC_SITE.depositPercent}% down payment to reserve your project, then complete the project intake. I review the scope and confirm your actual build week before work begins.`
                : 'Stripe checkout for the down payment opens soon. Start with the free site review below — I review the scope, confirm your build week, and send you the payment link the moment checkout is live.'}
            </p>

            <ul class="mt-9 grid gap-3 text-sm text-bone-dim sm:grid-cols-2">
              <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay" aria-hidden="true"></span><span>One-page business site or focused refresh</span></li>
              <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay" aria-hidden="true"></span><span>Mobile-first layout and clear customer action</span></li>
              <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay" aria-hidden="true"></span><span>Contact path, starter SEO, and share preview</span></li>
              <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-clay" aria-hidden="true"></span><span>You own the finished code</span></li>
            </ul>
          </div>

          <aside class="panel relative overflow-hidden p-6 sm:p-8" aria-label="Payment summary">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-clay to-transparent"></div>
            <p class="mono text-[11px] uppercase tracking-[0.22em] text-bone-muted">Project ledger</p>

            <div class="mt-7 border-y border-ink-line/70 py-6">
              <div class="flex items-end justify-between gap-5">
                <div>
                  <p class="text-sm text-bone-muted">Due today</p>
                  <p class="mt-1 font-display text-5xl font-medium text-bone">${BASIC_SITE.depositUsd}</p>
                </div>
                <span class="mono mb-1 rounded-sm border border-clay/50 bg-clay/10 px-2 py-1 text-xs uppercase tracking-[0.16em] text-clay">{BASIC_SITE.depositPercent}% down</span>
              </div>
              <div class="mt-6 flex items-center justify-between text-sm">
                <span class="text-bone-muted">Full package</span>
                <span class="mono text-bone">${BASIC_SITE.priceUsd}</span>
              </div>
              <div class="mt-2 flex items-center justify-between text-sm">
                <span class="text-bone-muted">Balance after down payment</span>
                <span class="mono text-bone">${BASIC_SITE.priceUsd - BASIC_SITE.depositUsd}</span>
              </div>
            </div>

            <p class="mt-5 text-sm leading-relaxed text-bone-dim">
              The ${BASIC_SITE.depositUsd} down payment is non-refundable. All other payments are refundable before launch.
            </p>

            {checkoutReady ? (
              <>
                <a
                  href={BASIC_SITE.paymentLink}
                  class="btn-primary mt-7 flex w-full items-center justify-center"
                  data-cta="start-pay-deposit"
                  data-section="start-payment"
                  data-intent="checkout:basic-deposit"
                >
                  <span class="relative z-10 flex items-center gap-2.5">
                    Pay ${BASIC_SITE.depositUsd} securely
                    <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </a>
                <p class="mt-3 text-center mono text-[10px] uppercase tracking-[0.16em] text-bone-muted">Secure checkout hosted by Stripe</p>

                <a href="#intake" data-cta="start-open-project-intake" data-section="start" data-intent="checkout:basic-deposit" class="mt-5 block text-center text-sm text-bone-dim underline decoration-clay/50 underline-offset-4" data-paid-intake-link>
                  Already paid? Open the project intake
                </a>
              </>
            ) : (
              <>
                <div class="mt-7 rounded-sm border border-ink-line bg-ink-soft/60 px-4 py-3">
                  <p class="mono text-[11px] uppercase tracking-[0.18em] text-bone-muted">Checkout opening soon</p>
                  <p class="mt-2 text-sm leading-relaxed text-bone-dim">
                    Online payment isn&rsquo;t wired up yet. The offer stands exactly as listed — start with the free review below and I&rsquo;ll send you the payment link directly once checkout is live.
                  </p>
                </div>
                <a
                  href="#intake"
                  class="btn-primary mt-5 flex w-full items-center justify-center"
                  data-cta="start-free-review"
                  data-section="start-payment"
                  data-intent="book:free-review"
                >
                  <span class="relative z-10 flex items-center gap-2.5">
                    Start with the free review
                    <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </a>
              </>
            )}
          </aside>
        </div>
      </div>
    </section>

    <section id="hosting-plan" class="pb-hq-section" aria-labelledby="hosting-plan-heading">
      <div class="container-page">
        <div class="panel grid gap-6 p-6 sm:p-8 lg:grid-cols-[1.2fr,0.8fr] lg:items-center">
          <div>
            <p class="mono text-[11px] uppercase tracking-[0.22em] text-bone-muted">Optional · after launch</p>
            <h2 id="hosting-plan-heading" class="mt-3 font-display text-2xl text-bone">Hosting + help, ${HOSTING_PLAN.monthlyUsd}/month</h2>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-bone-dim">
              Prefer not to manage hosting yourself? I keep the site online and handle small updates you ask for. It&rsquo;s optional: you still own the code and can take it elsewhere any time.
            </p>
          </div>
          {hostingCheckoutReady ? (
            <div>
              <a
                href={HOSTING_PLAN.paymentLink}
                class="btn-ghost flex w-full items-center justify-center"
                data-cta="start-subscribe-hosting"
                data-section="start-hosting"
                data-intent="checkout:hosting-plan"
              >
                Add hosting + help, ${HOSTING_PLAN.monthlyUsd}/month
              </a>
              <p class="mt-3 text-center mono text-[10px] uppercase tracking-[0.16em] text-bone-muted">Monthly subscription hosted by Stripe</p>
            </div>
          ) : (
            <a
              href="#intake"
              class="btn-ghost flex w-full items-center justify-center"
              data-cta="start-ask-hosting"
              data-section="start-hosting"
              data-intent="book:free-review"
            >
              Ask about it in your free review
            </a>
          )}
        </div>
      </div>
    </section>

    {checkoutReady ? (
      <div id="project-intake" hidden>
        <div class="container-page pt-10">
          <div class="panel border-clay/30 bg-clay/[0.04] p-5 text-sm text-bone-dim" role="status">
            <span class="font-medium text-bone">Checkout complete.</span> Send the project details below so I can confirm scope and your build week.
          </div>
        </div>
        <Intake
          eyebrow="Step 2 · Project intake"
          headline="Deposit handled. Tell me what we’re building."
          sub="Share the business, current site, main problem, and preferred timing. I’ll confirm the scope before work begins."
          source="basic-deposit"
          defaultIntent="checkout:basic-deposit"
          mode="project"
          submitLabel="Send project intake"
          successPath="/start/thanks"
          showStartWindow={true}
        />
      </div>
    ) : (
      <Intake source="start" />
    )}

    {checkoutReady && (
      <noscript>
        <div class="container-page pb-16 text-sm text-bone-dim">JavaScript is required to reveal the post-payment project intake. Email through the footer if you need help.</div>
      </noscript>
    )}
  </div>

  <Footer slot="footer" path="/start" />
</Layout>

<script>
  const query = new URLSearchParams(window.location.search);
  const intake = document.getElementById('project-intake');
  const deposit = document.getElementById('deposit-step');
  const showIntake = () => {
    if (!intake) return;
    intake.hidden = false;
    deposit?.setAttribute('hidden', '');
    requestAnimationFrame(() => {
      // <section id="intake"> is not focusable on its own; without a tabindex
      // focus() is a silent no-op and assistive tech never reaches step 2.
      const target = document.getElementById('intake');
      if (!target) return;
      if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    });
  };

  if (query.get('checkout') === 'complete') showIntake();
  document.querySelector('[data-paid-intake-link]')?.addEventListener('click', showIntake);
</script>
