---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { DROPS, LAUNCH_STATS } from '@/config/roadmap';

const released = DROPS.filter((drop) => drop.status === 'released');
const testing = DROPS.filter((drop) => drop.status === 'testing');
const roadmapPreview = DROPS.filter((drop) => drop.status === 'next' || drop.status === 'upcoming').slice(0, 4);

// 2026-08-19: department 01 was "Websites" -> /websites. m3mm.net is the main
// COMPANY page, so the website-services department is no longer one of its
// front doors; Resume takes the slot, which keeps this a four-card grid rather
// than leaving a hole in a four-column layout. /websites still exists, still
// builds, and is still reachable directly — restore the entry to bring it back.
const departments = [
  { number: '01', name: 'Release status', description: 'Official launches, test previews, and the difference between the two.', href: '#released', action: 'Open the ledger' },
  { number: '02', name: 'Roadmap', description: 'The shipping queue, launch order, dates, and signup for future product drops.', href: '/roadmap', action: 'View full roadmap' },
  { number: '03', name: 'Resume', description: 'Career surface: experience, the work behind it, and a downloadable resume.', href: '/resume', action: 'Open resume' },
  { number: '04', name: 'Company policies', description: 'The public policy library, including workplace vaccination and accessibility.', href: '/policies', action: 'Read policies' },
];

const isExternal = (url?: string) => Boolean(url?.startsWith('http'));
---

<Layout
  title="M3MM — The hub for everything Michael is building"
  description="M3MM is Michael Murillo-Martinez's main company hub: the official release, test deployments, client work, career proof, company policies, and the public roadmap."
  path="/"
>
  <Header slot="header" path="/" />

  <div class="hq-scope">
    <div class="scanlines" aria-hidden="true"></div>

    <section class="hero container-page" aria-labelledby="hub-heading">
      <div class="hero-copy">
        <div class="eyebrow"><span></span>M3MM · Company headquarters · Atlanta</div>
        <div class="brand-lockup">
          <img src="/mark-light.png" alt="M3MM" width="112" height="112" class="brand-mark" decoding="async" />
          <p class="brand-name">M3MM</p>
        </div>
        <h1 id="hub-heading">Everything I’m building.<br /><em>One front door.</em></h1>
        <p class="meaning">Modernize. Mobilize. Multiply.</p>
        <p class="hero-lede">
          M3MM is the umbrella for the products, client work, systems, and ideas I ship.
          Start with the official release, see what is being tested, or enter the department
          that matches why you are here.
        </p>
        <div class="hero-actions">
          <a href="#released" class="action action-live" data-cta="hq-released" data-section="hero" data-intent="product:released-work">
            See what’s released <span aria-hidden="true">↓</span>
          </a>
          <a href="/roadmap" class="action action-ghost" data-cta="hq-roadmap" data-section="hero" data-intent="product:roadmap">
            Open the roadmap <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside class="command-card" aria-label="M3MM release status">
        <div class="command-head"><span>PUBLIC BUILD STATUS</span><span class="system-live">● ONLINE</span></div>
        <div class="command-body">
          <p class="command-label">SHIPPING LEDGER</p>
          <p class="command-number">{String(LAUNCH_STATS.released).padStart(2, '0')}</p>
          <p class="command-caption">officially released</p>
          <dl class="command-stats">
            <div><dt>Next drop</dt><dd>{DROPS.find((drop) => drop.status === 'next')?.name ?? 'In review'}</dd></div>
            <div><dt>Test lab</dt><dd>{LAUNCH_STATS.testing} preview builds</dd></div>
            <div><dt>Roadmap</dt><dd>{LAUNCH_STATS.total} tracked builds</dd></div>
          </dl>
        </div>
        <div class="command-foot"><span>m3mm.net</span><span>HQ // 001</span></div>
      </aside>
    </section>

    <section class="departments container-page" aria-labelledby="departments-heading">
      <div class="section-intro">
        <p class="section-code">ROUTE // START HERE</p>
        <h2 id="departments-heading">One company.<br />Clear doors.</h2>
        <p>Use M3MM like a headquarters, not a single-purpose landing page.</p>
      </div>
      <ol class="department-grid">
        {departments.map((department) => (
          <li>
            <a href={department.href} class="department-card" data-cta={`hq-department-${department.number}`} data-section="departments" data-intent="product:company-department">
              <span class="department-number">{department.number}</span>
              <h3>{department.name}</h3>
              <p>{department.description}</p>
              <span class="department-action">{department.action} <b aria-hidden="true">↗</b></span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section id="released" class="released container-page" aria-labelledby="released-heading">
      <div class="ledger-title">
        <div>
          <p class="section-code section-code-live"><span></span> RELEASED // OFFICIAL LAUNCHES ONLY</p>
          <h2 id="released-heading">Officially<br />released.</h2>
        </div>
        <p class="ledger-note">
          A public test URL is not a release. Green is reserved for work M3MM has officially
          launched; reachable test builds are separated into the preview lab below.
        </p>
      </div>

      <ol class="release-ledger" aria-label="All released M3MM work">
        {released.map((drop, index) => (
          <li class="release-row">
            <div class="release-index">R-{String(index + 1).padStart(2, '0')}</div>
            <div class="release-main">
              <div class="release-meta">
                <span class="live-pip" aria-hidden="true"></span>
                <span>RELEASED</span>
                <span>{drop.category ?? 'M3MM build'}</span>
              </div>
              <h3>{drop.name}</h3>
              <p>{drop.blurb}</p>
            </div>
            {drop.url && (
              <a
                href={drop.url}
                class="launch-link"
                target={isExternal(drop.url) ? '_blank' : undefined}
                rel={isExternal(drop.url) ? 'noopener' : undefined}
                data-cta="hq-release-launch"
                data-section="released"
                data-intent="product:released-work"
                aria-label={`Open ${drop.name}`}
              >Open <span aria-hidden="true">↗</span></a>
            )}
          </li>
        ))}
      </ol>

      <div class="preview-lab" aria-labelledby="preview-heading">
        <div class="preview-title">
          <p class="section-code section-code-preview"><span></span> PREVIEW LAB // DEPLOYED FOR TESTING</p>
          <h3 id="preview-heading">Reachable does not mean released.</h3>
          <p>These builds can be opened for testing, but they do not count toward the official release total.</p>
        </div>
        <ol class="preview-list" aria-label="M3MM test deployments">
          {testing.map((drop) => (
            <li>
              <div>
                <span class="preview-status">TESTING · {drop.category ?? 'M3MM build'}</span>
                <h4>{drop.name}</h4>
                <p>{drop.blurb}</p>
              </div>
              {drop.url && (
                <a
                  href={drop.url}
                  target={isExternal(drop.url) ? '_blank' : undefined}
                  rel={isExternal(drop.url) ? 'noopener' : undefined}
                  data-cta="hq-preview-open"
                  data-section="released"
                  data-intent="product:test-preview"
                  aria-label={`Preview ${drop.name}`}
                >Preview <span aria-hidden="true">↗</span></a>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="roadmap" class="roadmap-preview" aria-labelledby="roadmap-heading">
      <div class="container-page roadmap-grid">
        <div class="roadmap-copy">
          <p class="section-code section-code-roadmap"><span></span> ROADMAP // SHIPPING QUEUE</p>
          <h2 id="roadmap-heading">What ships next matters.</h2>
          <p>
            The roadmap is a first-class part of M3MM. It shows the order, dates, and status of
            every planned drop. A test deployment stays labeled Testing; it turns green only
            after M3MM declares the official public release.
          </p>
          <a href="/roadmap" class="roadmap-button" data-cta="hq-roadmap-full" data-section="roadmap" data-intent="product:roadmap">
            View the complete roadmap <span aria-hidden="true">→</span>
          </a>
        </div>

        <ol class="queue" aria-label="Next roadmap releases">
          {roadmapPreview.map((drop, index) => (
            <li class={drop.status === 'next' ? 'queue-item queue-next' : 'queue-item'}>
              <div class="queue-order">{String(index + 1).padStart(2, '0')}</div>
              <div class="queue-date"><b>{drop.dateLabel}</b><span>{drop.year}</span></div>
              <div class="queue-body">
                <span>{drop.status === 'next' ? 'NEXT DROP' : drop.quarter}</span>
                <h3>{drop.name}</h3>
                <p>{drop.blurb}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="closing container-page" aria-labelledby="closing-heading">
      <img src="/mark-light.png" alt="" width="84" height="84" decoding="async" />
      <div>
        <p class="section-code">M3MM // BUILT IN PUBLIC</p>
        <h2 id="closing-heading">The hub grows when the work ships.</h2>
      </div>
      {/* 2026-08-19: was "Need a website? Start here" -> /websites. This is the
          main company page, so it no longer closes on the website-services
          department. /websites still exists and is still reachable directly. */}
      <a href="/roadmap" data-cta="hq-roadmap-closing" data-section="closing" data-intent="product:roadmap">See what ships next <span aria-hidden="true">↗</span></a>
    </section>
  </div>

  <Footer slot="footer" path="/" />
</Layout>

<style>
  .hq-scope { --hq-red:#ff2d3d; --hq-green:#22ff66; --hq-amber:#ffb020; --hq-preview:#6ed0ff; --hq-card:#191922; --hq-line:#2a2a36; --hq-muted:#a3a3b0; position:relative; isolation:isolate; overflow:hidden; }
  .scanlines { position:absolute; inset:0; z-index:-1; pointer-events:none; opacity:.42; background:repeating-linear-gradient(to bottom,transparent 0 3px,rgba(255,255,255,.016) 3px 4px); }
  .hero { min-height:calc(100vh - 96px); display:grid; grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr); gap:clamp(40px,8vw,110px); align-items:center; padding-top:clamp(48px,8vw,92px); padding-bottom:clamp(72px,10vw,130px); }
  .eyebrow,.section-code,.release-meta,.command-card,.meaning { font-family:ui-monospace,"Cascadia Mono","SFMono-Regular",Menlo,Consolas,monospace; text-transform:uppercase; letter-spacing:.13em; }
  .eyebrow { display:flex; align-items:center; gap:12px; color:var(--hq-muted); font-size:11px; font-weight:700; }
  .eyebrow span { width:38px; height:2px; background:var(--hq-red); }
  .brand-lockup { display:flex; align-items:center; gap:18px; margin-top:30px; }
  .brand-mark { width:clamp(62px,8vw,94px); height:clamp(62px,8vw,94px); object-fit:contain; }
  .brand-name { margin:0; color:#e8e8ee; font:900 clamp(44px,7vw,76px)/.86 'Impact','Arial Black',sans-serif; letter-spacing:-.02em; }
  .hero h1,.section-intro h2,.ledger-title h2,.roadmap-copy h2,.closing h2 { font-family:'Impact','Arial Black',sans-serif; text-transform:uppercase; color:#e8e8ee; letter-spacing:-.025em; }
  .hero h1 { margin:30px 0 0; font-size:clamp(55px,8.4vw,112px); line-height:.88; }
  .hero h1 em { color:var(--hq-red); font-style:normal; }
  .meaning { margin:22px 0 0; font-size:11px; color:var(--hq-muted); font-weight:700; }
  .hero-lede { max-width:690px; margin:24px 0 0; color:#c4c4cf; font-size:clamp(17px,2vw,21px); line-height:1.65; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; }
  .action { display:inline-flex; gap:22px; align-items:center; justify-content:space-between; min-width:220px; padding:15px 18px; font-weight:800; text-decoration:none; border:1px solid var(--hq-line); transition:transform .16s ease,background .16s ease,border-color .16s ease; }
  .action:hover,.action:focus-visible { transform:translateY(-2px); }
  .action-live { color:#07110a; background:var(--hq-green); border-color:var(--hq-green); }
  .action-live:hover,.action-live:focus-visible { background:#fff; }
  .action-ghost { color:#e8e8ee; background:transparent; }
  .action-ghost:hover,.action-ghost:focus-visible { border-color:var(--hq-red); color:#fff; }
  .command-card { border:1px solid var(--hq-line); background:rgba(25,25,34,.88); box-shadow:18px 18px 0 rgba(255,45,61,.08); }
  .command-head,.command-foot { display:flex; justify-content:space-between; gap:18px; padding:12px 14px; font-size:9px; color:var(--hq-muted); border-bottom:1px solid var(--hq-line); }
  .command-foot { border:0; border-top:1px solid var(--hq-line); }
  .system-live { color:var(--hq-green); }
  .command-body { padding:clamp(24px,4vw,42px); }
  .command-label { margin:0; color:var(--hq-muted); font-size:10px; }
  .command-number { margin:10px 0 0; color:var(--hq-green); font:900 clamp(86px,12vw,148px)/.85 'Impact','Arial Black',sans-serif; letter-spacing:-.04em; }
  .command-caption { margin:12px 0 30px; color:#e8e8ee; font-size:11px; }
  .command-stats { margin:0; }
  .command-stats div { display:grid; grid-template-columns:90px 1fr; gap:10px; padding:12px 0; border-top:1px solid var(--hq-line); font-size:10px; }
  .command-stats dt { color:var(--hq-muted); }
  .command-stats dd { margin:0; color:#e8e8ee; text-align:right; }
  .departments { padding-top:100px; padding-bottom:120px; }
  .section-intro { display:grid; grid-template-columns:minmax(240px,.8fr) minmax(250px,1fr); column-gap:70px; align-items:end; }
  .section-code { margin:0 0 14px; color:var(--hq-muted); font-size:10px; font-weight:800; }
  .section-intro .section-code { grid-column:1/-1; }
  .section-intro h2,.ledger-title h2 { margin:0; font-size:clamp(50px,7vw,84px); line-height:.92; }
  .section-intro>p:last-child { margin:0 0 4px; max-width:420px; color:var(--hq-muted); font-size:18px; line-height:1.6; }
  .department-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); list-style:none; padding:0; margin:46px 0 0; border-top:1px solid var(--hq-line); border-left:1px solid var(--hq-line); }
  .department-grid li { min-width:0; }
  .department-card { min-height:310px; height:100%; display:flex; flex-direction:column; padding:24px; color:#e8e8ee; text-decoration:none; border-right:1px solid var(--hq-line); border-bottom:1px solid var(--hq-line); background:rgba(13,14,20,.35); transition:background .18s ease; }
  .department-card:hover,.department-card:focus-visible { background:var(--hq-card); }
  .department-number { color:var(--hq-red); font:800 11px/1 ui-monospace,monospace; letter-spacing:.14em; }
  .department-card h3 { margin:56px 0 0; font-size:26px; text-transform:uppercase; }
  .department-card p { margin:14px 0 28px; color:var(--hq-muted); line-height:1.55; font-size:14px; }
  .department-action { margin-top:auto; display:flex; justify-content:space-between; gap:12px; color:#e8e8ee; font:700 11px/1.3 ui-monospace,monospace; text-transform:uppercase; letter-spacing:.08em; }
  .released { padding-top:110px; padding-bottom:130px; }
  .ledger-title { display:grid; grid-template-columns:1fr minmax(260px,430px); gap:70px; align-items:end; }
  .section-code-live { color:var(--hq-green); }
  .section-code-live span,.section-code-roadmap span { display:inline-block; width:8px; height:8px; border-radius:50%; background:currentColor; margin-right:7px; box-shadow:0 0 10px currentColor; }
  .ledger-note { margin:0 0 6px; color:var(--hq-muted); line-height:1.65; }
  .release-ledger { list-style:none; padding:0; margin:48px 0 0; border-top:1px solid var(--hq-line); }
  .release-row { display:grid; grid-template-columns:74px minmax(0,1fr) auto; gap:24px; align-items:center; padding:26px 0; border-bottom:1px solid var(--hq-line); }
  .release-index { align-self:start; padding-top:4px; color:#727280; font:800 10px/1 ui-monospace,monospace; letter-spacing:.12em; }
  .release-meta { display:flex; flex-wrap:wrap; align-items:center; gap:9px; color:var(--hq-green); font-size:9px; font-weight:800; }
  .release-meta span:last-child { color:var(--hq-muted); padding-left:9px; border-left:1px solid var(--hq-line); }
  .live-pip { width:7px; height:7px; border-radius:50%; background:var(--hq-green); box-shadow:0 0 9px var(--hq-green); }
  .release-main h3 { margin:10px 0 0; color:#e8e8ee; font-size:clamp(24px,3vw,36px); line-height:1.05; text-transform:uppercase; }
  .release-main p { max-width:820px; margin:11px 0 0; color:var(--hq-muted); font-size:14px; line-height:1.6; }
  .launch-link { display:inline-flex; align-items:center; gap:18px; padding:12px 15px; border:1px solid var(--hq-green); color:var(--hq-green); font:800 10px/1 ui-monospace,monospace; letter-spacing:.1em; text-decoration:none; text-transform:uppercase; }
  .launch-link:hover,.launch-link:focus-visible { color:#081009; background:var(--hq-green); }
  .preview-lab { display:grid; grid-template-columns:minmax(230px,.58fr) minmax(0,1.42fr); gap:clamp(36px,7vw,92px); margin-top:72px; padding:34px; border:1px solid rgba(110,208,255,.45); background:rgba(110,208,255,.045); }
  .section-code-preview { color:var(--hq-preview); }
  .section-code-preview span { display:inline-block; width:8px; height:8px; margin-right:7px; border-radius:50%; background:currentColor; box-shadow:0 0 10px currentColor; }
  .preview-title h3 { margin:0; color:#e8e8ee; font-size:clamp(28px,3.4vw,43px); line-height:1; text-transform:uppercase; }
  .preview-title>p:last-child { margin:18px 0 0; color:var(--hq-muted); font-size:14px; line-height:1.6; }
  .preview-list { list-style:none; padding:0; margin:0; border-top:1px solid var(--hq-line); }
  .preview-list li { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:24px; align-items:center; padding:20px 0; border-bottom:1px solid var(--hq-line); }
  .preview-status { color:var(--hq-preview); font:800 9px/1 ui-monospace,monospace; letter-spacing:.11em; text-transform:uppercase; }
  .preview-list h4 { margin:7px 0 0; color:#e8e8ee; font-size:20px; text-transform:uppercase; }
  .preview-list p { margin:7px 0 0; color:var(--hq-muted); font-size:12px; line-height:1.55; }
  .preview-list a { display:inline-flex; align-items:center; gap:14px; padding:11px 13px; border:1px solid var(--hq-preview); color:var(--hq-preview); font:800 9px/1 ui-monospace,monospace; letter-spacing:.1em; text-decoration:none; text-transform:uppercase; }
  .preview-list a:hover,.preview-list a:focus-visible { color:#071015; background:var(--hq-preview); }
  .roadmap-preview { border-top:1px solid rgba(255,45,61,.45); border-bottom:1px solid rgba(255,45,61,.45); background:linear-gradient(135deg,rgba(255,45,61,.085),rgba(25,25,34,.3)); }
  .roadmap-grid { display:grid; grid-template-columns:minmax(260px,.72fr) minmax(0,1.28fr); gap:clamp(50px,8vw,110px); padding-top:120px; padding-bottom:120px; }
  .section-code-roadmap { color:var(--hq-red); }
  .roadmap-copy h2 { margin:0; font-size:clamp(54px,7vw,88px); line-height:.9; }
  .roadmap-copy>p:not(.section-code) { margin:24px 0 0; color:#b7b7c3; font-size:17px; line-height:1.65; }
  .roadmap-button { display:flex; justify-content:space-between; gap:25px; margin-top:32px; padding:16px 18px; border:1px solid var(--hq-red); background:var(--hq-red); color:#09090d; font-weight:900; text-decoration:none; }
  .roadmap-button:hover,.roadmap-button:focus-visible { background:#fff; border-color:#fff; }
  .queue { list-style:none; padding:0; margin:0; border-top:1px solid var(--hq-line); }
  .queue-item { display:grid; grid-template-columns:42px 86px minmax(0,1fr); gap:20px; padding:22px 0; border-bottom:1px solid var(--hq-line); }
  .queue-next { border-bottom-color:rgba(255,176,32,.45); }
  .queue-order { color:#727280; font:800 10px/1.4 ui-monospace,monospace; }
  .queue-date { padding-right:15px; border-right:1px solid var(--hq-line); text-align:right; }
  .queue-date b,.queue-date span { display:block; font-family:ui-monospace,monospace; }
  .queue-date b { color:#e8e8ee; font-size:12px; }
  .queue-date span { margin-top:5px; color:var(--hq-muted); font-size:9px; }
  .queue-body>span { color:var(--hq-red); font:800 9px/1 ui-monospace,monospace; letter-spacing:.12em; }
  .queue-next .queue-body>span { color:var(--hq-amber); }
  .queue-body h3 { margin:7px 0 0; color:#e8e8ee; font-size:22px; text-transform:uppercase; }
  .queue-body p { margin:8px 0 0; color:var(--hq-muted); font-size:13px; line-height:1.55; }
  .closing { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:28px; align-items:center; padding-top:110px; padding-bottom:20px; }
  .closing img { width:64px; height:64px; object-fit:contain; }
  .closing h2 { margin:0; font-size:clamp(34px,4.5vw,60px); line-height:.95; }
  .closing a { color:#e8e8ee; border-bottom:1px solid var(--hq-red); padding:9px 0; text-decoration:none; font-weight:800; }
  .closing a:hover,.closing a:focus-visible { color:var(--hq-red); }
  @media (max-width:980px) {
    .hero { grid-template-columns:1fr; min-height:auto; }
    .command-card { max-width:560px; }
    .department-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .ledger-title,.preview-lab,.roadmap-grid { grid-template-columns:1fr; }
    .ledger-note { max-width:620px; }
    .closing { grid-template-columns:auto 1fr; }
    .closing a { grid-column:2; justify-self:start; }
  }
  @media (max-width:640px) {
    .hero { padding-top:32px; }
    .brand-lockup { margin-top:24px; }
    .hero h1 { font-size:clamp(48px,15vw,72px); }
    .action { width:100%; }
    .section-intro { display:block; }
    .section-intro>p:last-child { margin-top:22px; }
    .department-grid { grid-template-columns:1fr; }
    .department-card { min-height:240px; }
    .department-card h3 { margin-top:38px; }
    .ledger-title { gap:24px; }
    .release-row { grid-template-columns:38px minmax(0,1fr); gap:14px; }
