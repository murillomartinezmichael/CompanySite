---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Intake from '@/components/Intake.astro';
---

<Layout
  title="Free site review — M3MM"
  description="Two-minute intake. Free review of your business site — a 5-minute recorded video teardown, personally, within 24 hours."
  path="/audit"
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'Free site review', url: '/audit' },
  ]}
>
  <Header slot="header" minimal={true} path="/audit" />

  <section class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[600px] bg-gradient-to-b from-clay/[0.10] via-transparent to-transparent"></div>

    <div class="container-page relative pb-4 pt-14 sm:pt-20">
      <div class="max-w-3xl">
        <div class="mb-6 flex items-center gap-3">
          <span class="hairline"></span>
          <p class="kicker">You clicked the link. Now the actual value.</p>
        </div>

        <h1 class="text-display-lg">
          Turn your TikTok viewers into <span class="text-bone-dim">customers.</span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg text-bone-dim">
          Free site review — I'll pull up your site personally (Lighthouse, mobile, funnel, copy) and record a 5-minute video teardown of what's costing you DMs and quote requests, in your inbox within 24 hours. If nothing needs fixing, I'll tell you that too.
        </p>

        <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-bone-muted">
          <li>✓ No sales call</li>
          <li>✓ Recorded video teardown, not a template</li>
          <li>✓ 24h reply, personally</li>
          <li>✓ Free — actually free</li>
        </ul>

        <!-- Under-$500 template link -->
        <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-bone-muted">
          <span class="mono text-[11px] uppercase tracking-[0.2em] text-clay/80">Budget under $500?</span>
          <a
            href="https://siteguide-production.up.railway.app/demos?utm_source=m3mm&utm_medium=audit&utm_campaign=downshift&utm_content=audit-under-500"
            class="group inline-flex items-center gap-1.5 text-bone-dim underline decoration-clay/50 decoration-1 underline-offset-[6px] transition-colors hover:text-clay"
            data-cta="downshift-siteguide"
            data-section="audit-hero"
            data-intent="product:siteguide"
            target="_blank"
            rel="noopener"
          >
            Preview the SiteGuide test storefront
            <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

        <!-- Client proof — same named outcomes rendered on the Hero. -->
        <div class="mt-12 grid gap-5 border-t border-ink-line/60 pt-8 sm:grid-cols-2">
          <div class="panel flex flex-col gap-2 p-5">
            <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">Aries Outdoor Living</span>
            <p class="text-sm leading-snug text-bone-dim">
              Same intake, same 24h review. <span class="text-bone">Deployed and sold</span> · first quote request 3 days after handoff.
            </p>
          </div>
          <div class="panel flex flex-col gap-2 p-5">
            <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">Big 7 Construction</span>
            <p class="text-sm leading-snug text-bone-dim">
              Same intake. <span class="text-bone">Build + Repair test deployment complete</span> — official launch waits on real jobsite photography.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Intake
    eyebrow="Step 1 · Tell me what to look at"
    headline="What's on your site and what's frustrating you about it?"
    sub="The more specific you are, the more useful the review. If you don't have a site yet, say that — I'll review the funnel you have (Instagram, phone-only, etc.) and tell you what a site would change."
    source="audit-page"
  />

  <Footer slot="footer" path="/audit" />
</Layout>
