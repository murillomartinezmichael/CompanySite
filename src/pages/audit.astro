---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Intake from '@/components/Intake.astro';
---

<Layout
  title="Free site review — M3MM"
  description="Two-minute intake. Free review of your business site — a 5-minute recorded video teardown, personally, within 24 hours."
  path="/audit"
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'Free site review', url: '/audit' },
  ]}
>
  <Header slot="header" minimal={true} path="/audit" />


<section class="page-intro container-page m3-hero"><div><p class="m3-eyebrow">Free site review</p><h1>A clearer view of<br/>what needs fixing.</h1><p class="m3-lede">I’ll review your site personally—Lighthouse, mobile, funnel and copy—and send a 5-minute recorded video teardown within 24 hours. If nothing needs fixing, I’ll tell you that too.</p><div class="m3-actions"><a href="#intake" class="m3-button primary" data-cta="audit-intake" data-section="audit-hero" data-intent="book:free-review">Request the free review ↓</a><a href="/websites#proof" class="m3-link" data-cta="audit-proof" data-section="audit-hero">See the client work →</a></div></div><aside class="m3-manifesto" aria-label="What to expect"><div><span>01 / Share</span><strong>Two-minute intake.</strong><p>Your business, current site and the problem you’re seeing.</p></div><div><span>02 / Review</span><strong>Personal, not a template.</strong><p>Recorded video teardown, not a template. No sales call.</p></div><div><span>03 / Decide</span><strong>A useful next step.</strong><p>Keep the review. Decide whether a repair or a build makes sense.</p></div></aside></section>

  <Intake
    eyebrow="Step 1 · Tell me what to look at"
    headline="What's on your site and what's frustrating you about it?"
    sub="The more specific you are, the more useful the review. If you don't have a site yet, say that — I'll review the funnel you have (Instagram, phone-only, etc.) and tell you what a site would change."
    source="audit-page"
  />

  <section class="container-page"><p class="m3-lede">Need a lower-cost self-serve option?</p><a
            href="https://siteguide-production.up.railway.app/demos?utm_source=m3mm&utm_medium=audit&utm_campaign=downshift&utm_content=audit-under-500"
            class="m3-link"
            data-cta="downshift-siteguide"
            data-section="audit-hero"
            data-intent="product:siteguide"
            target="_blank"
            rel="noopener"
          >
            Preview the SiteGuide test storefront
            <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a></section>
<Footer slot="footer" path="/audit" />
</Layout>
