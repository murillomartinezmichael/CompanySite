---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RoadmapFilters from '@/components/RoadmapFilters.astro';import RoadmapTimeline from '@/components/RoadmapTimeline.astro';import {DROPS,LAUNCH_STATS} from '@/config/roadmap';
const grouped=DROPS.reduce<Record<string,typeof DROPS>>((a,d)=>{(a[d.quarter]||=[]).push(d);return a;},{});const quarterOrder=Object.keys(grouped);const intakePost='/api/lead';
---
<Layout title="Project Roadmap — M3MM" description="The M3MM public project release registry, with clear status, proposed targets and a separate infrastructure track." path="/roadmap">
<Header slot="header" path="/roadmap" />

<section class="m3-intro container-page"><p class="m3-eyebrow">Roadmaps / Projects</p><h1>What’s released.<br/>What comes next.</h1><p class="m3-lede">{LAUNCH_STATS.released} official release. Testing previews stay separate. Planned dates are targets, and a past target is not a release announcement.</p><div class="m3-actions"><a class="m3-link" href="/roadmaps/infrastructure" data-cta="roadmap-infrastructure" data-section="roadmap">Open the separate Infrastructure Roadmap →</a><a class="m3-link" href="#signup-heading" data-cta="roadmap-follow" data-section="roadmap">Follow a build ↓</a></div></section>
<div class="container-page m3-section roadmap-scope"><RoadmapFilters/>{quarterOrder.map((q,index)=><section data-roadmap-quarter aria-labelledby={'quarter-'+index} class="m3-roadmap-group"><div class="m3-section-head"><h2 id={'quarter-'+index}>{q}</h2><p>{grouped[q].length} {grouped[q].length===1?'build':'builds'}</p></div><RoadmapTimeline drops={grouped[q]}/></section>)}
<section class="signup" aria-labelledby="signup-heading">
        <h2 id="signup-heading" class="section-head">Follow a build</h2>
        <p class="signup-copy">Leave your email and the builds you’re interested in. Your request goes directly to M3MM.</p>

        <form
          id="roadmap-signup"
          action={intakePost}
          method="POST"
          class="signup-form"
          data-success-path="/roadmap/thanks"
        >
          <input type="hidden" name="source" value="roadmap" />
          <input type="hidden" name="intent" value="book:roadmap-subscribe" />
          <input type="hidden" name="name" value="Roadmap subscriber" />
          <input type="hidden" name="businessType" value="roadmap-subscriber" />
          <!-- Both the JS handler and native endpoint fold selected topics
               into the note. This neutral fallback makes an empty selection
               valid without inventing an update cadence. -->
          <input
            type="hidden"
            name="frustration"
            value="Roadmap subscriber update request."
          />

          <label class="field">
            <span class="field-label"><span>Email</span></span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@work.com"
            />
          </label>

          <label class="field">
            <span class="field-label"><span>Only tell me about</span></span>
            <input
              type="text"
              name="topics"
              maxlength="200"
              placeholder="e.g. AIMA, SiteGuide, everything"
            />
          </label>

          <!-- honeypot -->
          <label class="hp" aria-hidden="true">
            <span>Company website (leave blank)</span>
            <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
          </label>

          <button type="submit" class="signup-btn" data-cta="roadmap-subscribe" data-section="roadmap" data-intent="book:roadmap-subscribe">
            Request updates
          </button>
        </form>

        <p id="roadmap-status" class="signup-status" role="status" aria-live="polite" hidden></p>

        <p class="fine">
          This sends an update request. You can also return here to check release status.
        </p>
      </section></div>
<script>
  import { track } from '@/lib/track';
  import { createInquirySubmission, isInquiryAccepted, InquiryRetryError, inquiryErrorMessage, showInquiryRecovery } from '@/lib/inquiry-submission';

  const form = document.getElementById('roadmap-signup') as HTMLFormElement | null;
  const status = document.getElementById('roadmap-status') as HTMLParagraphElement | null;

  const DEFAULT_NOTE = 'Roadmap subscriber update request.';

  if (form && status) {
    const submission = createInquirySubmission(undefined, { scope: 'roadmap' });
    let sending = false;
    let accepted = false;
    const show = (text: string, kind: 'pending' | 'ok' | 'error') => {
      status.textContent = text;
      status.classList.remove('is-ok', 'is-error');
      if (kind !== 'pending') status.classList.add(kind === 'ok' ? 'is-ok' : 'is-error');
      status.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending || accepted) return;
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      const originalLabel = submitBtn?.textContent;
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

      if (data.company_website) {
        show('Sent — check your inbox.', 'ok');
        return;
      }

      // The endpoint's note field has a 10-character floor, so the optional
      // "only tell me about" box is folded into a sentence rather than sent raw.
      const topics = String(data.topics || '').trim();
      delete data.topics;
      data.frustration = topics ? `Roadmap subscriber wants: ${topics}` : DEFAULT_NOTE;

      sending = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }
      show('Sending…', 'pending');

      try {
        const attempt = await submission.prepare(data);
        if (attempt.accepted) throw new InquiryRetryError('confirmed');
        const res = await fetch('/api/lead', {
          method: 'POST',
          redirect: 'error',
          headers: {
            'Content-Type': 'application/json',
            'Idempotency-Key': attempt.key,
          },
          body: JSON.stringify(data),
        });
        if (!(await isInquiryAccepted(res))) throw new Error(`Unconfirmed inquiry: HTTP ${res.status}`);
        accepted = true;
        const recoverySaved = submission.markAccepted(attempt.key);

        track({
          name: 'intake_submit',
          section: 'roadmap',
          intent: 'book:roadmap-subscribe',
          meta: { source: 'roadmap', has_prefill: false, message_length: topics.length },
        });
        show(recoverySaved ? 'Got it. Redirecting…' : 'Got it. Your inquiry was confirmed, but this browser could not save its retry reference. Do not resend. Redirecting…', 'ok');
        form.reset();
        const destination = form.dataset.successPath || '/thanks';
        setTimeout(() => { window.location.href = destination; }, 450);
      } catch (error) {
        track({
          name: 'intake_error',
          section: 'roadmap',
          intent: 'book:roadmap-subscribe',
          meta: { source: 'roadmap', has_prefill: false, message_length: topics.length },
        });
        show(inquiryErrorMessage(error), 'error');
        showInquiryRecovery(form, status, error, () => {
          const current = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
          const selectedTopics = String(current.topics || '').trim();
          delete current.topics;
          current.frustration = selectedTopics ? `Roadmap subscriber wants: ${selectedTopics}` : DEFAULT_NOTE;
          return submission.allowSeparate(current);
        });
      } finally {
        sending = false;
        if (!accepted && submitBtn && originalLabel) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
    });
  }
</script><style>.m3-roadmap-group{margin-top:3rem;padding-top:2rem;border-top:1px solid rgb(var(--ink-line))}.m3-roadmap-group h2{font-size:1.65rem;max-width:30ch}.signup{padding:2rem;margin-top:4rem;background:rgb(var(--ink-soft));border:1px solid rgb(var(--ink-line));border-radius:var(--m3-radius)}.signup-copy{margin-top:1rem;color:rgb(var(--bone-dim))}.signup-form{display:flex;gap:1rem;flex-wrap:wrap;align-items:end;margin-top:1.5rem}.field{flex:1;min-width:200px}.field-label{display:block;margin-bottom:.5rem;font-size:.875rem}.field input{width:100%}.signup-btn{min-height:48px;padding:.75rem 1.5rem;border-radius:8px;color:rgb(var(--ink));background:rgb(var(--clay));font-weight:600}.fine,.signup-status{margin-top:1rem;color:rgb(var(--bone-muted));font-size:.875rem}.hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}@media(max-width:600px){.signup{padding:1.25rem}.field,.signup-btn{width:100%}}</style>
<Footer slot="footer" path="/roadmap" />
</Layout>
