---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { DROPS, LAUNCH_STATS } from '@/config/roadmap';

// Group drops by quarter label for the timeline sections.
const grouped = DROPS.reduce<Record<string, typeof DROPS>>((acc, d) => {
  (acc[d.quarter] ||= []).push(d);
  return acc;
}, {} as Record<string, typeof DROPS>);
const quarterOrder = Array.from(new Set(DROPS.map((d) => d.quarter)));
const statusLabels = {
  released: 'Released',
  next: 'Next',
  testing: 'Testing',
  upcoming: 'Planned',
} as const;

// Intake POST target. Reuses the site's existing lead endpoint so roadmap
// subscribers flow through the same pipeline as any other intake.
const intakePost = '/api/lead';
---

<Layout
  title="Roadmap — M3MM"
  description="M3MM's official release roadmap: the Hub is released, test deployments are labeled separately, Aries Outdoor Living is next, and Big7 is waiting on jobsite photography."
  path="/roadmap"
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'Roadmap', url: '/roadmap' },
  ]}
>
  <Header slot="header" minimal={true} path="/roadmap" />

  <section class="roadmap-scope">
    <!-- Scanlines overlay — decorative, disabled under reduced motion. -->
    <div class="scanlines" aria-hidden="true"></div>

    <div class="container-page py-14 sm:py-20">
      <div class="mb-6 flex items-center gap-3">
        <span class="hairline hairline-red"></span>
        <p class="kicker mono">One drop · every two weeks · public receipts</p>
      </div>

      <div class="brand-heading">
        <img src="/mark-light.png" alt="M3MM" width="96" height="96" class="brand-mark" decoding="async" />
        <h1 class="brand-display">ROADMAP</h1>
      </div>
      <p class="brand-meaning">Modernize. Mobilize. Multiply.</p>

      <p class="lede">
        <strong>{LAUNCH_STATS.released} official release: the M3MM Hub.</strong> Aries Outdoor Living is
        the next public hard launch. Some other builds have reachable test deployments; those stay
        labeled <em>Testing</em> and do not count as releases. Big7 remains long-term while M3MM waits
        for real jobsite photography.
      </p>

      <ul class="stats" role="list">
        <li class="stat"><b>{LAUNCH_STATS.total}</b><span>Tracked builds</span></li>
        <li class="stat"><b>{LAUNCH_STATS.released}</b><span>Official release</span></li>
        <li class="stat"><b>{LAUNCH_STATS.testing}</b><span>Test previews</span></li>
        <li class="stat"><b>Aries</b><span>Next launch</span></li>
      </ul>

      {quarterOrder.map((q) => (
        <section>
          <h2 class="section-head">{q}</h2>
          <ol class="timeline">
            {grouped[q].map((d) => (
              <li class={`item item-${d.status}`}>
                <div class="date">
                  <b>{d.dateLabel}</b>{d.year}
                </div>
                <div class="body">
                  <h3>
                    {d.url
                      ? <a href={d.url} rel={d.url.startsWith('http') ? 'noopener' : undefined} data-cta="roadmap-drop-open" data-section="roadmap" data-intent="product:roadmap-drop" data-release-status={d.status}>{d.name}</a>
                      : d.name}
                    <span class={`status status-${d.status}`}>
                      {statusLabels[d.status]}
                    </span>
                  </h3>
                  <p>{d.blurb}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <section class="signup" aria-labelledby="signup-heading">
        <h2 id="signup-heading" class="section-head">Get the drops</h2>
        <p class="signup-copy">One email per drop. Never anything else. Unsubscribe on any send.</p>

        <form
          id="roadmap-signup"
          action={intakePost}
          method="POST"
          class="signup-form"
          data-success-path="/thanks"
        >
          <input type="hidden" name="source" value="roadmap" />
          <input type="hidden" name="intent" value="book:roadmap-subscribe" />
          <input type="hidden" name="name" value="Roadmap subscriber" />
          <input type="hidden" name="businessType" value="roadmap-subscriber" />
          <!-- The endpoint requires a note field. With JS the submit handler
               folds the "only tell me about" box into it; without JS this
               default ships as-is, so a native POST is always a complete,
               valid lead rather than a validation error. -->
          <input
            type="hidden"
            name="frustration"
            value="Roadmap subscriber — notify me on every drop."
          />

          <label class="field">
            <span class="field-label"><span>Email</span></span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@work.com"
            />
          </label>

          <label class="field">
            <span class="field-label"><span>Only tell me about</span></span>
            <input
              type="text"
              name="topics"
              maxlength="200"
              placeholder="e.g. AIMA, SiteGuide, everything"
            />
          </label>

          <!-- honeypot -->
          <label class="hp" aria-hidden="true">
            <span>Company website (leave blank)</span>
            <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
          </label>

          <button type="submit" class="signup-btn" data-cta="roadmap-subscribe" data-section="roadmap" data-intent="book:roadmap-subscribe">
            Notify me
          </button>
        </form>

        <p id="roadmap-status" class="signup-status" role="status" aria-live="polite" hidden></p>

        <p class="fine">
          Rules: no upsells, no drip sequences, no "here's a case study" filler.
          If a drop slips, you'll hear about that too.
        </p>
      </section>

      <p class="foot-note">
        Public test deployments stay marked Testing until the official launch. Schedule changes get logged here, not hidden.
      </p>
    </div>
  </section>

  <Footer slot="footer" path="/roadmap" />
</Layout>

<script>
  import { track } from '@/lib/track';

  const form = document.getElementById('roadmap-signup') as HTMLFormElement | null;
  const status = document.getElementById('roadmap-status') as HTMLParagraphElement | null;

  const DEFAULT_NOTE = 'Roadmap subscriber — notify me on every drop.';

  if (form && status) {
    const show = (text: string, kind: 'pending' | 'ok' | 'error') => {
      status.textContent = text;
      status.classList.remove('is-ok', 'is-error');
      if (kind !== 'pending') status.classList.add(kind === 'ok' ? 'is-ok' : 'is-error');
      status.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      const originalLabel = submitBtn?.textContent;
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

      if (data.company_website) {
        show('Sent — check your inbox.', 'ok');
        return;
      }

      // The endpoint's note field has a 10-character floor, so the optional
      // "only tell me about" box is folded into a sentence rather than sent raw.
      const topics = String(data.topics || '').trim();
      delete data.topics;
      data.frustration = topics ? `Roadmap subscriber wants: ${topics}` : DEFAULT_NOTE;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }
      show('Sending…', 'pending');

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        track({
          name: 'intake_submit',
          section: 'roadmap',
          intent: 'book:roadmap-subscribe',
          meta: { source: 'roadmap', has_prefill: false, message_length: topics.length },
        });
        show('Got it. Redirecting…', 'ok');
        form.reset();
        const destination = form.dataset.successPath || '/thanks';
        setTimeout(() => { window.location.href = destination; }, 450);
      } catch {
        track({
          name: 'intake_error',
          section: 'roadmap',
          intent: 'book:roadmap-subscribe',
          meta: { source: 'roadmap', has_prefill: false, message_length: topics.length },
        });
        show('Something broke on send. Email murillomartinezmichael@gmail.com and I\'ll pick it up manually.', 'error');
      } finally {
        if (submitBtn && originalLabel) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
    });
  }
</script>

<style>
  /* Roadmap-scoped visual language: red accent + LED pulse + subtle scanlines.
     Isolated under .roadmap-scope so the rest of the site's clay/teal accent
     stays untouched. Matches the original roadmap draft's visual spec. */
  .roadmap-scope {
    --red: #ff2d3d;
    --red-glow: rgba(255, 45, 61, 0.25);
    --amber: #ffb020;
    --green: #22ff66;
    --preview: #6ed0ff;
    --ink-dim: #8a8a99;
    /* #55555f measured 2.37:1 on --card and 2.62:1 on the page ground — both
       below the WCAG 1.4.3 AA floor of 4.5:1 for body copy. #8a8a99 measures
       5.12:1 on --card and 5.61:1 on the ground. It is the dimmest grey in
       this palette that still clears 4.5:1 against --card, which is why it
       lands on the same value as --ink-dim. */
    --ink-mute: #8a8a99;
    --line: #24242f;
    --card: #191922;
    position: relative;
    isolation: isolate;
  }

  .roadmap-scope .scanlines {
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgba(255, 255, 255, 0.014) 2px 3px
    );
    pointer-events: none;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .roadmap-scope .scanlines { display: none; }
  }

  .roadmap-scope .hairline-red { background: var(--red); }

  .roadmap-scope .brand-heading {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 28px);
    margin-top: 8px;
  }
  .roadmap-scope .brand-mark {
    width: clamp(52px, 8vw, 82px);
    height: clamp(52px, 8vw, 82px);
    flex: none;
    object-fit: contain;
  }

  .roadmap-scope .brand-display {
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', var(--tw-font-display, sans-serif);
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
    text-transform: uppercase;
    color: #e8e8ee;
  }
  .roadmap-scope .brand-meaning {
    margin: 14px 0 0;
    color: var(--ink-dim);
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .roadmap-scope .lede {
    max-width: 640px;
    margin: 20px 0 8px;
    font-size: 17px;
    line-height: 1.6;
  }
  .roadmap-scope .lede strong { color: var(--red); font-weight: 700; }
  .roadmap-scope .lede em { font-style: italic; }

  .roadmap-scope .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 28px 0 12px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    list-style: none;
  }
  .roadmap-scope .stat { padding: 4px 0; }
  .roadmap-scope .stat b {
    display: block;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 34px;
    color: var(--red);
    line-height: 1;
  }
  .roadmap-scope .stat span {
    display: block;
    font-size: 11px;
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 6px;
  }

  .roadmap-scope .section-head {
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 32px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 48px 0 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--red);
    display: inline-block;
    color: #e8e8ee;
  }

  .roadmap-scope .timeline {
    position: relative;
    margin: 12px 0;
    padding: 0 0 0 32px;
    list-style: none;
  }
  .roadmap-scope .timeline::before {
    content: "";
    position: absolute;
    left: 8px; top: 0; bottom: 0;
    width: 2px;
    background: var(--line);
  }

  .roadmap-scope .item {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 18px 20px;
    margin: 0 0 14px;
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    align-items: start;
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 15px;
    line-height: 1.55;
  }
  .roadmap-scope .item::before {
    content: "";
    position: absolute;
    left: -32px; top: 22px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--ink-mute);
    border: 3px solid #0D0E14;
    box-shadow: 0 0 0 2px var(--line);
  }
  .roadmap-scope .item-released::before {
    background: var(--green);
    box-shadow: 0 0 0 2px var(--line), 0 0 12px var(--green);
    animation: roadmap-pulse 2.4s ease-in-out infinite;
  }
  .roadmap-scope .item-next::before {
    background: var(--amber);
    box-shadow: 0 0 0 2px var(--line), 0 0 10px var(--amber);
  }
  .roadmap-scope .item-testing::before {
    background: var(--preview);
    box-shadow: 0 0 0 2px var(--line), 0 0 10px var(--preview);
  }
  .roadmap-scope .item-upcoming::before {
    background: var(--red);
    box-shadow: 0 0 0 2px var(--line);
  }

  @keyframes roadmap-pulse {
    0%, 100% { box-shadow: 0 0 0 2px var(--line), 0 0 6px var(--green); }
    50%      { box-shadow: 0 0 0 2px var(--line), 0 0 16px var(--green); }
  }
  @media (prefers-reduced-motion: reduce) {
    .roadmap-scope .item-released::before { animation: none; }
  }

  .roadmap-scope .date {
    font-size: 12px;
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-top: 2px;
    border-right: 1px solid var(--line);
    padding-right: 12px;
    text-align: right;
  }
  .roadmap-scope .date b {
    display: block;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 20px;
    color: #e8e8ee;
    letter-spacing: 0.02em;
  }

  .roadmap-scope .body h3 {
    margin: 0 0 4px;
    font-size: 20px;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: #e8e8ee;
  }
  .roadmap-scope .body h3 a { color: #e8e8ee; text-decoration: none; border-bottom: 1px solid transparent; }
  .roadmap-scope .body h3 a:hover,
  .roadmap-scope .body h3 a:focus-visible { color: var(--red); border-bottom-color: var(--red); }
  .roadmap-scope .body p {
    margin: 4px 0 0;
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.55;
  }

  .roadmap-scope .status {
    display: inline-block;
    font-size: 10px;
    padding: 2px 8px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    border: 1px solid currentColor;
    vertical-align: middle;
    margin-left: 8px;
    position: relative;
    top: -3px;
  }
  .roadmap-scope .status-released { color: var(--green); }
  .roadmap-scope .status-next { color: var(--amber); }
  .roadmap-scope .status-testing { color: var(--preview); }
  .roadmap-scope .status-upcoming { color: var(--red); }

  .roadmap-scope .signup {
    margin: 48px 0 24px;
    padding: 28px;
    background: var(--card);
    border: 1px solid var(--red);
    box-shadow: 0 0 20px var(--red-glow);
  }
  .roadmap-scope .signup .section-head { margin-top: 0; }
  .roadmap-scope .signup-copy { color: var(--ink-dim); margin: 4px 0 0; }
  .roadmap-scope .signup-form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 16px;
    align-items: flex-end;
  }
  .roadmap-scope .field {
    flex: 1 1 260px;
    display: block;
  }
  .roadmap-scope .field-label {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }
  .roadmap-scope .field input {
    display: block;
    width: 100%;
    padding: 10px 12px;
    background: #0D0E14;
    border: 1px solid var(--line);
    color: #e8e8ee;
    font-family: inherit;
    font-size: 15px;
    border-radius: 4px;
  }
  .roadmap-scope .field input:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
    border-color: var(--red);
  }
  .roadmap-scope .signup-btn {
    align-self: flex-end;
    padding: 12px 24px;
    background: var(--red);
    color: #000;
    border: none;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    font-weight: 700;
    border-radius: 4px;
  }
  .roadmap-scope .signup-btn:hover,
  .roadmap-scope .signup-btn:focus-visible {
    background: #fff;
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  .roadmap-scope .signup-status {
    margin: 12px 0 0;
    padding: 10px 12px;
    border: 1px solid var(--ink-dim);
    border-radius: 4px;
    font-size: 14px;
    color: #e8e8ee;
    background: #0D0E14;
  }
  .roadmap-scope .signup-status[hidden] { display: none; }
  .roadmap-scope .signup-status.is-ok { border-color: var(--green); }
  .roadmap-scope .signup-status.is-error { border-color: var(--red); }
  .roadmap-scope .signup-status a { color: var(--green); }

  .roadmap-scope .fine {
    font-size: 12px;
    color: var(--ink-mute);
    margin-top: 12px;
  }
  .roadmap-scope .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .roadmap-scope .foot-note {
    margin: 32px 0 0;
    color: var(--ink-mute);
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .roadmap-scope .item { grid-template-columns: 1fr; gap: 8px; }
    .roadmap-scope .date {
      border-right: none;
      border-bottom: 1px solid var(--line);
      text-align: left;
      padding-right: 0;
      padding-bottom: 6px;
    }
    .roadmap-scope .timeline { padding-left: 24px; }
    .roadmap-scope .item::before { left: -24px; top: 20px; width: 12px; height: 12px; }
  }
</style>
