---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { DROPS, LAUNCH_STATS } from '@/config/roadmap';

// Group drops by quarter label for the timeline sections.
const grouped = DROPS.reduce<Record<string, typeof DROPS>>((acc, d) => {
  (acc[d.quarter] ||= []).push(d);
  return acc;
}, {} as Record<string, typeof DROPS>);
const quarterOrder = Array.from(new Set(DROPS.map((d) => d.quarter)));

// Intake POST target. Reuses the site's existing lead endpoint so roadmap
// subscribers flow through the same pipeline as any other intake.
const intakePost = '/api/lead';
---

<Layout
  title="Roadmap — M³"
  description="M³ shipping schedule. New product or tool goes live every two weeks. No vaporware — every rung on this list is code that already runs."
  path="/roadmap"
  breadcrumbs={[
    { name: 'M³', url: '/' },
    { name: 'Roadmap', url: '/roadmap' },
  ]}
>
  <Header slot="header" minimal={true} path="/roadmap" />

  <section class="roadmap-scope">
    <!-- Scanlines overlay — decorative, disabled under reduced motion. -->
    <div class="scanlines" aria-hidden="true"></div>

    <div class="container-page py-14 sm:py-20">
      <div class="mb-6 flex items-center gap-3">
        <span class="hairline hairline-red"></span>
        <p class="kicker mono">One drop · every two weeks · public receipts</p>
      </div>

      <h1 class="brand-display">
        M<span class="red">³</span> ROADMAP
      </h1>

      <p class="lede">
        M³ is shipping <strong>{DROPS.length} tools, sites, and services</strong> — one at a time,
        one every two weeks, in the order below. Each drop is code that <em>already runs</em>.
        No vaporware, no waitlists that never resolve. When a release goes live, you can use it
        that day.
      </p>

      <ul class="stats" role="list">
        <li class="stat"><b>{LAUNCH_STATS.total}</b><span>Total drops</span></li>
        <li class="stat"><b>{LAUNCH_STATS.live}</b><span>Live now</span></li>
        <li class="stat"><b>2 wks</b><span>Cadence</span></li>
        <li class="stat"><b>~11 mo</b><span>Full launch window</span></li>
      </ul>

      {quarterOrder.map((q) => (
        <section>
          <h2 class="section-head">{q}</h2>
          <ol class="timeline">
            {grouped[q].map((d) => (
              <li class={`item item-${d.status}`}>
                <div class="date">
                  <b>{d.dateLabel}</b>{d.year}
                </div>
                <div class="body">
                  <h3>
                    {d.url
                      ? <a href={d.url} rel={d.url.startsWith('http') ? 'noopener' : undefined}>{d.name}</a>
                      : d.name}
                    <span class={`status status-${d.status}`}>
                      {d.status === 'live' ? 'Live' : d.status === 'next' ? 'Next' : 'Upcoming'}
                    </span>
                  </h3>
                  <p>{d.blurb}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <section class="signup" aria-labelledby="signup-heading">
        <h2 id="signup-heading" class="section-head">Get the drops</h2>
        <p class="signup-copy">One email per drop. Never anything else. Unsubscribe on any send.</p>

        <form action={intakePost} method="POST" class="signup-form" novalidate>
          <input type="hidden" name="source" value="roadmap" />
          <input type="hidden" name="intent" value="book:roadmap-subscribe" />
          <input type="hidden" name="name" value="Roadmap subscriber" />
          <input type="hidden" name="businessType" value="roadmap-subscriber" />

          <label class="field">
            <span class="field-label"><span>Email</span></span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@work.com"
            />
          </label>

          <label class="field">
            <span class="field-label"><span>Only tell me about</span></span>
            <input
              type="text"
              name="frustration"
              maxlength="200"
              placeholder="e.g. AIMA, SiteGuide, everything"
            />
          </label>

          <!-- honeypot -->
          <label class="hp" aria-hidden="true">
            <span>Company website (leave blank)</span>
            <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
          </label>

          <button type="submit" class="signup-btn" data-cta="roadmap-subscribe" data-section="roadmap" data-intent="book:roadmap-subscribe">
            Notify me
          </button>
        </form>

        <p class="fine">
          Rules: no upsells, no drip sequences, no "here's a case study" filler.
          If a drop slips, you'll hear about that too.
        </p>
      </section>

      <p class="foot-note">
        Dates target Mondays. Slips will be logged here, not hidden.
      </p>
    </div>
  </section>

  <Footer slot="footer" path="/roadmap" />
</Layout>

<style>
  /* Roadmap-scoped visual language: red accent + LED pulse + subtle scanlines.
     Isolated under .roadmap-scope so the rest of the site's clay/teal accent
     stays untouched. Matches the M3_Roadmap_DRAFT.html visual spec. */
  .roadmap-scope {
    --red: #ff2d3d;
    --red-glow: rgba(255, 45, 61, 0.25);
    --amber: #ffb020;
    --green: #22ff66;
    --ink-dim: #8a8a99;
    --ink-mute: #55555f;
    --line: #24242f;
    --card: #191922;
    position: relative;
    isolation: isolate;
  }

  .roadmap-scope .scanlines {
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgba(255, 255, 255, 0.014) 2px 3px
    );
    pointer-events: none;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .roadmap-scope .scanlines { display: none; }
  }

  .roadmap-scope .hairline-red { background: var(--red); }

  .roadmap-scope .brand-display {
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', var(--tw-font-display, sans-serif);
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 8px 0 0;
    text-transform: uppercase;
    color: #e8e8ee;
  }
  .roadmap-scope .brand-display .red { color: var(--red); }

  .roadmap-scope .lede {
    max-width: 640px;
    margin: 20px 0 8px;
    font-size: 17px;
    line-height: 1.6;
  }
  .roadmap-scope .lede strong { color: var(--red); font-weight: 700; }
  .roadmap-scope .lede em { font-style: italic; }

  .roadmap-scope .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 28px 0 12px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    list-style: none;
  }
  .roadmap-scope .stat { padding: 4px 0; }
  .roadmap-scope .stat b {
    display: block;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 34px;
    color: var(--red);
    line-height: 1;
  }
  .roadmap-scope .stat span {
    display: block;
    font-size: 11px;
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 6px;
  }

  .roadmap-scope .section-head {
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 32px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 48px 0 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--red);
    display: inline-block;
    color: #e8e8ee;
  }

  .roadmap-scope .timeline {
    position: relative;
    margin: 12px 0;
    padding: 0 0 0 32px;
    list-style: none;
  }
  .roadmap-scope .timeline::before {
    content: "";
    position: absolute;
    left: 8px; top: 0; bottom: 0;
    width: 2px;
    background: var(--line);
  }

  .roadmap-scope .item {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 18px 20px;
    margin: 0 0 14px;
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    align-items: start;
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 15px;
    line-height: 1.55;
  }
  .roadmap-scope .item::before {
    content: "";
    position: absolute;
    left: -32px; top: 22px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--ink-mute);
    border: 3px solid #0D0E14;
    box-shadow: 0 0 0 2px var(--line);
  }
  .roadmap-scope .item-live::before {
    background: var(--green);
    box-shadow: 0 0 0 2px var(--line), 0 0 12px var(--green);
    animation: roadmap-pulse 2.4s ease-in-out infinite;
  }
  .roadmap-scope .item-next::before {
    background: var(--amber);
    box-shadow: 0 0 0 2px var(--line), 0 0 10px var(--amber);
  }
  .roadmap-scope .item-upcoming::before {
    background: var(--red);
    box-shadow: 0 0 0 2px var(--line);
  }

  @keyframes roadmap-pulse {
    0%, 100% { box-shadow: 0 0 0 2px var(--line), 0 0 6px var(--green); }
    50%      { box-shadow: 0 0 0 2px var(--line), 0 0 16px var(--green); }
  }
  @media (prefers-reduced-motion: reduce) {
    .roadmap-scope .item-live::before { animation: none; }
  }

  .roadmap-scope .date {
    font-size: 12px;
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-top: 2px;
    border-right: 1px solid var(--line);
    padding-right: 12px;
    text-align: right;
  }
  .roadmap-scope .date b {
    display: block;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 20px;
    color: #e8e8ee;
    letter-spacing: 0.02em;
  }

  .roadmap-scope .body h3 {
    margin: 0 0 4px;
    font-size: 20px;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: #e8e8ee;
  }
  .roadmap-scope .body h3 a { color: #e8e8ee; text-decoration: none; border-bottom: 1px solid transparent; }
  .roadmap-scope .body h3 a:hover,
  .roadmap-scope .body h3 a:focus-visible { color: var(--red); border-bottom-color: var(--red); }
  .roadmap-scope .body p {
    margin: 4px 0 0;
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.55;
  }

  .roadmap-scope .status {
    display: inline-block;
    font-size: 10px;
    padding: 2px 8px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    border: 1px solid currentColor;
    vertical-align: middle;
    margin-left: 8px;
    position: relative;
    top: -3px;
  }
  .roadmap-scope .status-live { color: var(--green); }
  .roadmap-scope .status-next { color: var(--amber); }
  .roadmap-scope .status-upcoming { color: var(--red); }

  .roadmap-scope .signup {
    margin: 48px 0 24px;
    padding: 28px;
    background: var(--card);
    border: 1px solid var(--red);
    box-shadow: 0 0 20px var(--red-glow);
  }
  .roadmap-scope .signup .section-head { margin-top: 0; }
  .roadmap-scope .signup-copy { color: var(--ink-dim); margin: 4px 0 0; }
  .roadmap-scope .signup-form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 16px;
    align-items: flex-end;
  }
  .roadmap-scope .field {
    flex: 1 1 260px;
    display: block;
  }
  .roadmap-scope .field-label {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }
  .roadmap-scope .field input {
    display: block;
    width: 100%;
    padding: 10px 12px;
    background: #0D0E14;
    border: 1px solid var(--line);
    color: #e8e8ee;
    font-family: inherit;
    font-size: 15px;
    border-radius: 4px;
  }
  .roadmap-scope .field input:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
    border-color: var(--red);
  }
  .roadmap-scope .signup-btn {
    align-self: flex-end;
    padding: 12px 24px;
    background: var(--red);
    color: #000;
    border: none;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 16px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    font-weight: 700;
    border-radius: 4px;
  }
  .roadmap-scope .signup-btn:hover,
  .roadmap-scope .signup-btn:focus-visible {
    background: #fff;
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  .roadmap-scope .fine {
    font-size: 12px;
    color: var(--ink-mute);
    margin-top: 12px;
  }
  .roadmap-scope .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .roadmap-scope .foot-note {
    margin: 32px 0 0;
    color: var(--ink-mute);
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .roadmap-scope .item { grid-template-columns: 1fr; gap: 8px; }
    .roadmap-scope .date {
      border-right: none;
      border-bottom: 1px solid var(--line);
      text-align: left;
      padding-right: 0;
      padding-bottom: 6px;
    }
    .roadmap-scope .timeline { padding-left: 24px; }
    .roadmap-scope .item::before { left: -24px; top: 20px; width: 12px; height: 12px; }
  }
</style>