---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { referralOffer } from '../../functions/_lib/referral';

// Referral program — same config the auto-reply email renders from, so the
// page and the inbox never state different terms.
const referral = referralOffer();
---

<Layout
  title="Thanks — I'll reply within 24 hours · M3MM"
  description="Your intake landed. What happens next: a recorded video teardown from Michael, within 24 hours, no template reply."
  path="/thanks"
  noindex={true}
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'Free site review', url: '/audit' },
    { name: 'Thanks', url: '/thanks' },
  ]}
>
  <Header slot="header" minimal={true} path="/thanks" />

  <section class="relative isolate overflow-hidden">

    <div class="container-page relative py-hq-section">
      <div class="max-w-3xl">
        <div class="mb-6 flex items-center gap-3">
          <span class="hairline"></span>
          <p class="kicker mono">// Sent · queued for personal review</p>
        </div>

        <h1 class="text-hq-hero">
          Got it. <span class="text-bone-dim">Reply within</span>
          <span class="highlight-yellow"><span class="fg">24 hours.</span></span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg text-bone-dim">
          Real reply, not a template. I'll actually pull your site up — Lighthouse,
          mobile, funnel, copy — and email back a 5-minute recorded video teardown
          of what's costing you DMs and quote requests. One engineer. Same guy who
          quotes it builds it.
        </p>

        <!-- What happens next — three checkpoint cards -->
        <ol class="mt-14 grid gap-5 sm:grid-cols-3">
          <li class="panel flex flex-col gap-2 p-6">
            <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">Now</span>
            <p class="font-medium text-bone">Intake landed</p>
            <p class="text-sm text-bone-dim">Sitting in my inbox. Nothing on your side.</p>
          </li>
          <li class="panel flex flex-col gap-2 p-6">
            <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">Next 24h</span>
            <p class="font-medium text-bone">Personal review</p>
            <p class="text-sm text-bone-dim">I pull up your site or funnel and read it carefully.</p>
          </li>
          <li class="panel flex flex-col gap-2 p-6">
            <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">Email back</span>
            <p class="font-medium text-bone">Video teardown</p>
            <p class="text-sm text-bone-dim">A 5-minute recorded walkthrough: what's working, what's leaking customers, rough scope if a rebuild fits.</p>
          </li>
        </ol>

        <!-- Client proof — same named outcomes rendered on the Hero. -->
        <div class="mt-16 border-t border-ink-line/60 pt-10">
          <p class="kicker mono mb-6">// Same review, real clients</p>
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="panel flex flex-col gap-2 p-6">
              <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">Aries Outdoor Living</span>
              <p class="text-sm leading-snug text-bone-dim">
                Same intake, same 24h review. <span class="text-bone">Deployed and sold</span> · first quote request 3 days after handoff.
              </p>
            </div>
            <div class="panel flex flex-col gap-2 p-6">
              <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">Big 7 Construction</span>
              <p class="text-sm leading-snug text-bone-dim">
                Same intake. <span class="text-bone">Build + Repair test deployment complete</span> — official launch waits on real jobsite photography.
              </p>
            </div>
          </div>
        </div>

        <!-- While-you-wait links -->
        <div class="mt-16 border-t border-ink-line/60 pt-10">
          <p class="kicker mono mb-6">// While you wait</p>
          <div class="grid gap-6 sm:grid-cols-2">
            <a
              href="/websites?intent=product:case-studies#proof"
              class="group panel flex flex-col gap-2 p-6 transition-colors hover:bg-ink-soft/60"
              data-cta="thanks-see-work"
              data-section="thanks"
              data-intent="product:case-studies"
            >
              <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">→ See recent work</span>
              <p class="font-medium text-bone">Aries · Big 7 · SiteGuide</p>
              <p class="text-sm text-bone-dim">Real client sites, real outcomes, real code.</p>
            </a>
            <a
              href="https://siteguide-production.up.railway.app/demos?utm_source=m3mm&utm_medium=thanks&utm_campaign=downshift&utm_content=thanks-storefront"
              target="_blank"
              rel="noopener"
              class="group panel flex flex-col gap-2 p-6 transition-colors hover:bg-ink-soft/60"
              data-cta="thanks-siteguide"
              data-section="thanks"
              data-intent="product:siteguide"
            >
              <span class="mono text-[10px] uppercase tracking-[0.22em] text-clay/80">→ Off-the-shelf templates</span>
              <p class="font-medium text-bone">SiteGuide storefront</p>
              <p class="text-sm text-bone-dim">Preview twelve one-page templates while the storefront remains in testing.</p>
            </a>
          </div>
        </div>

        <!-- Referral block -->
        <div class="mt-14 rounded-2xl border border-ink-line bg-ink-soft/40 p-6 sm:p-8">
          <p class="kicker mono mb-3">// Referrals</p>
          <p class="text-lg font-medium text-bone">{referral.headline}</p>
          <p class="mt-2 text-bone-dim">{referral.body}</p>
          <a
            href="/audit#intake"
            class="mt-5 inline-flex items-center gap-2 text-sm text-clay underline decoration-clay/50 decoration-1 underline-offset-[6px] hover:text-bone"
            data-cta="thanks-referral"
            data-section="thanks"
            data-intent="book:free-review"
          >
            Send them the review form
          </a>
        </div>

        <!-- Same-day path -->
        <div class="panel mt-14 p-6 sm:p-8">
          <p class="kicker mono mb-3 text-clay/80">// If it's actually urgent</p>
          <p class="text-bone-dim">
            This can't wait a day —
            <a
              href="/audit?intent=book:urgent-review#intake"
              class="underline decoration-clay/60 decoration-1 underline-offset-[6px] text-bone hover:text-clay"
              data-cta="thanks-urgent-email"
              data-section="thanks"
              data-intent="book:urgent-review"
              data-em-u="murillomartinezmichael"
              data-em-h="gmail.com"
              data-em-sub="Urgent — from audit form (m3mm.net)"
              data-em-body={"Hey Mike,\n\nBusiness (so you can match this to my intake): \nWhat's urgent: \nDeadline: \n\n— sent from m3mm.net /thanks urgent path"}
            >email me directly</a>
            and put "urgent" in the subject. Reply time drops to same-day.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Hydrate the urgent-email link to a real mailto: without leaving the
    // address in HTML source. Same mechanism as Footer + Accessibility: a raw
    // mailto: in server HTML trips Cloudflare's Email Address Obfuscation,
    // which injects a render-blocking email-decode script (~200 ms in the LCP
    // critical chain). Without JS the link falls through to /audit#intake, so
    // the CTA is never a dead end. Visible link text stays "email me
    // directly" so the sentence still reads naturally after hydration.
    (function () {
      var a = document.querySelector('a[data-cta="thanks-urgent-email"]');
      if (!a || !a.dataset.emU || !a.dataset.emH) return;
      var addr = a.dataset.emU + '@' + a.dataset.emH;
      var sub = a.dataset.emSub || '', body = a.dataset.emBody || '';
      var q = (sub || body)
        ? '?subject=' + encodeURIComponent(sub) + '&body=' + encodeURIComponent(body)
        : '';
      a.href = 'mailto:' + addr + q;
    })();
  </script>

  <Footer slot="footer" path="/thanks" />
</Layout>
