---
import Layout from '@/layouts/Layout.astro';import Header from '@/components/Header.astro';import Footer from '@/components/Footer.astro';
import {getCollection} from 'astro:content';import CaseStudy from '@/components/CaseStudy.astro';
import {PUBLIC_PROJECTS,statusLabel} from '@/config/public-projects';
export function getStaticPaths(){return PUBLIC_PROJECTS.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;const studies=await getCollection('caseStudies');const caseId=/aries/i.test(project.name)?'aries':/big.?7/i.test(project.name)?'big7':null;const study=studies.find(entry=>entry.id===caseId);const pagePath='/projects/'+project.slug;
---
<Layout title={project.name+' — M3MM Projects'} description={project.blurb} path={pagePath} breadcrumbs={[{name:'M3MM',url:'/'},{name:'Projects',url:'/projects'},{name:project.name,url:pagePath}]}><Header slot="header" path={pagePath}/>
<article class="container-page"><header class="m3-intro"><p class="m3-eyebrow">Projects / {project.category||'Product development'}</p><span class="m3-status" data-status={project.status}>{statusLabel(project.status)}</span><h1>{project.name}</h1><p class="m3-lede">{project.blurb}</p></header><dl class="m3-detail-meta"><div><dt>Public lifecycle</dt><dd>{statusLabel(project.status)}</dd></div><div><dt>Registry grouping</dt><dd>{project.quarter}</dd></div><div><dt>Recorded target label</dt><dd>{project.dateLabel} · {project.year}</dd></div></dl><section class="m3-section m3-split"><div><p class="m3-eyebrow">What this status means</p><h2>Evidence before a release claim.</h2></div><div class="m3-reading"><p>{project.status==='released'?'This entry is marked officially released in the existing public registry.':project.status==='testing'?'This is a testing preview. Availability does not establish production readiness or an official public release.':project.status==='next'?'This is the next official launch in the existing registry. Its public launch remains distinct from a deployed client build.':'This is a proposed build or a project waiting on its release requirements. Past target dates do not mean the work has shipped.'}</p><p>Project ownership and launch decisions remain with the existing project owner. This directory does not change either.</p><div class="m3-actions">{project.url&&<a class="m3-button primary" href={project.url} target={project.url.startsWith('http')?'_blank':undefined} rel={project.url.startsWith('http')?'noopener':undefined} data-cta="project-open" data-section="project" aria-label={'Open '+project.name}>{project.status==='testing'?'Open testing preview':'Open project'} ↗</a>}<a class="m3-button" href="/roadmap" data-cta="project-roadmap" data-section="project">See roadmap context →</a></div></div></section>{study&&<section class="m3-section"><h2>Client case study</h2><CaseStudy entry={study} index={0}/></section>}<section class="m3-close"><div><h2>Have a related project?</h2><p>Start with the problem you need to solve, not a feature list.</p></div><a class="m3-button" href="/contact" data-cta="project-contact" data-section="project">Talk to Michael →</a></section></article><Footer slot="footer" path={pagePath}/></Layout>
