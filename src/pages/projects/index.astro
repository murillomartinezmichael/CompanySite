---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { DROPS, LAUNCH_STATS } from '@/config/roadmap';
import { projectSlug } from '@/lib/project-slugs';
import '@/styles/explore.css';

const statusLabels = {
  released: 'Officially released',
  testing: 'Testing preview',
  next: 'Next official release',
  upcoming: 'Planned release',
};
---
<Layout title="Projects — M3MM" description="Explore M3MM software products, client work, previews and planned launches without confusing testing with an official release." path="/projects" breadcrumbs={[{ name: 'M3MM', url: '/' }, { name: 'Projects', url: '/projects' }]}>
  <Header slot="header" path="/projects" minimal={true} />
  <main class="explore-page">
    <div class="container-page explore-shell">
      <div class="explore-intro">
        <p class="explore-eyebrow">M3MM / What we build</p>
        <h1 class="explore-title">Projects, without the clutter.</h1>
        <p class="explore-lede">Browse public software products, client work and experiments in one directory. A public preview is not an official launch; each project's release state follows the existing M3MM release ledger.</p>
        <div class="explore-meta" style="margin-top: 1.25rem;">
          <span>{LAUNCH_STATS.total} tracked builds</span><span>•</span>
          <span>{LAUNCH_STATS.released} officially released</span><span>•</span>
          <span>{LAUNCH_STATS.testing} in testing</span>
        </div>
        <div class="explore-actions">
          <a href="/roadmap" class="explore-button explore-button-primary" data-cta="projects-roadmap" data-section="projects" data-intent="product:roadmap">Project roadmap →</a>
          <a href="/environment" class="explore-button explore-button-secondary" data-cta="projects-environment" data-section="projects" data-intent="product:environment">Explore the environment</a>
        </div>
      </div>

      <section id="directory" class="explore-section" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Project directory</h2>
        <p>Search or filter by official release state. These labels come from the maintained public roadmap, not assumptions based on deployment links.</p>
        <label for="project-search" class="explore-note" style="display:block;margin-top:1.4rem;margin-bottom:.35rem;">Search projects</label>
        <input id="project-search" class="explore-input" type="search" placeholder="Project name, category or description" autocomplete="off" />
        <div class="explore-filters" role="group" aria-label="Filter projects by release state">
          <button type="button" data-project-filter="all" aria-pressed="true">All</button>
          <button type="button" data-project-filter="released" aria-pressed="false">Released</button>
          <button type="button" data-project-filter="testing" aria-pressed="false">Testing</button>
          <button type="button" data-project-filter="next" aria-pressed="false">Next</button>
          <button type="button" data-project-filter="upcoming" aria-pressed="false">Planned</button>
        </div>
        <p id="project-count" class="explore-note" role="status" aria-live="polite">{DROPS.length} projects shown.</p>
        <div class="explore-grid explore-grid-3" style="margin-top:1.2rem;" id="project-results">
          {DROPS.map((drop) => (
            <article class="explore-card" data-project-item data-status={drop.status} data-search={`${drop.name} ${drop.blurb} ${drop.category ?? 'Product'}`.toLowerCase()}>
              <span class="explore-tag">{statusLabels[drop.status]}</span>
              <h3>{drop.name}</h3>
              <p>{drop.blurb}</p>
              <p class="explore-note">{drop.category ?? 'Product'} · {drop.quarter}</p>
              <a class="explore-link" href={`/projects/${projectSlug(drop.name)}`} data-cta="project-directory-detail" data-section="projects" data-intent="product:company-hub">View project details →</a>
            </article>
          ))}
        </div>
        <p id="project-empty" class="explore-note explore-empty" hidden style="margin-top:1rem;">No projects match this search. Try a different name or release state.</p>
      </section>
      <section class="explore-section explore-divider">
        <h2>How project and environment roadmaps connect</h2>
        <p>Project milestones track what M3MM intends to ship. The environment roadmap tracks the supporting compute, networking, security and storage work. They are separate plans with different completion criteria.</p>
        <a href="/roadmaps" class="explore-link" data-cta="projects-roadmaps-compare" data-section="projects" data-intent="product:roadmap">Compare both roadmaps →</a>
      </section>
    </div>
  </main>
  <Footer slot="footer" path="/projects" />
</Layout>
<script>
  const input = document.getElementById('project-search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-item]'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
  const count = document.getElementById('project-count');
  const empty = document.getElementById('project-empty');
  let selected = 'all';
  const update = () => {
    const term = input?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    for (const card of cards) {
      const matches = (selected === 'all' || card.dataset.status === selected) && (card.dataset.search ?? '').includes(term);
      card.hidden = !matches;
      if (matches) visible++;
    }
    if (count) count.textContent = `${visible} of ${cards.length} projects shown.`;
    if (empty) empty.hidden = visible !== 0;
  };
  for (const button of filters) button.addEventListener('click', () => {
    selected = button.dataset.projectFilter ?? 'all';
    for (const option of filters) option.setAttribute('aria-pressed', String(option === button));
    update();
  });
  input?.addEventListener('input', update);
</script>
