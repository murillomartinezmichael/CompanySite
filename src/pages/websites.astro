---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import TwoDoor from '@/components/TwoDoor.astro';
import Proof from '@/components/Proof.astro';
import Services from '@/components/Services.astro';
import Faq from '@/components/Faq.astro';
import Intake from '@/components/Intake.astro';
---

<Layout
  title="M3MM Websites — Websites that get you customers"
  description="M3MM's website-services department: custom business websites, sellable templates, free site reviews, and lead-generating launch systems."
  path="/websites"
  breadcrumbs={[
    { name: 'M3MM', url: '/' },
    { name: 'Websites', url: '/websites' },
  ]}
>
  <Header slot="header" path="/websites" />
  <Hero />
  <TwoDoor />
  <Proof />
  <Services />
  <Faq />
  <Intake />
  <Footer slot="footer" path="/websites" />
</Layout>
