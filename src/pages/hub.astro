---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { DROPS, LAUNCH_STATS } from '@/config/roadmap';

// Sort by launch date so tiles read the same order as the roadmap.
const tiles = [...DROPS].sort((a, b) => a.date.localeCompare(b.date));

function statusLabel(s: string) {
  return s === 'live' ? 'Live' : s === 'next' ? 'Next up' : 'Upcoming';
}
---

<Layout
  title="The Hub — M³"
  description="Live dashboard for every M³ product and tool. Tiles light up green the day each drop goes live."
  path="/hub"
  breadcrumbs={[
    { name: 'M³', url: '/' },
    { name: 'Hub', url: '/hub' },
  ]}
>
  <Header slot="header" minimal={true} path="/hub" />

  <section class="hub-scope">
    <div class="scanlines" aria-hidden="true"></div>

    <div class="container-page py-14 sm:py-20">
      <div class="mb-6 flex items-center gap-3">
        <span class="hairline hairline-red"></span>
        <p class="kicker mono">Live product dashboard · updates the day a drop ships</p>
      </div>

      <h1 class="brand-display">
        THE <span class="red">HUB</span>
      </h1>

      <p class="lede">
        Every M³ product and tool, in one place. Green means it's live right now — click to
        launch. Amber is the next drop. Red is the queue. See the full shipping schedule on the
        <a href="/roadmap" class="lede-link">roadmap</a>.
      </p>

      <ul class="stats" role="list">
        <li class="stat"><b>{LAUNCH_STATS.live}</b><span>Live</span></li>
        <li class="stat"><b>{LAUNCH_STATS.next}</b><span>Next up</span></li>
        <li class="stat"><b>{LAUNCH_STATS.upcoming}</b><span>Upcoming</span></li>
        <li class="stat"><b>{LAUNCH_STATS.total}</b><span>Total drops</span></li>
      </ul>

      <ul class="grid" role="list" aria-label="M³ product tiles">
        {tiles.map((t) => (
          <li class={`tile tile-${t.status}`}>
            <div class="tile-head">
              <span class={`pip pip-${t.status}`} aria-hidden="true"></span>
              <span class="tile-status">{statusLabel(t.status)}</span>
              <span class="tile-date">{t.dateLabel} · {t.year}</span>
            </div>

            <h2 class="tile-name">{t.name}</h2>
            <p class="tile-blurb">{t.blurb}</p>

            <div class="tile-foot">
              {t.status === 'live' && t.url ? (
                <a
                  href={t.url}
                  class="btn btn-launch"
                  data-cta="hub-launch"
                  data-section="hub"
                  data-intent="product:hub-launch"
                  rel={t.url.startsWith('http') ? 'noopener' : undefined}
                  aria-label={`Launch ${t.name}`}
                >
                  Launch <span aria-hidden="true">▸</span>
                </a>
              ) : (
                <a
                  href={`/roadmap#signup-heading`}
                  class="btn btn-notify"
                  data-cta="hub-notify"
                  data-section="hub"
                  data-intent="book:roadmap-subscribe"
                  aria-label={`Notify me when ${t.name} launches`}
                >
                  Notify me
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>

      <p class="foot-note">
        Tiles light up green the day a drop goes live.
      </p>
    </div>
  </section>

  <Footer slot="footer" path="/hub" />
</Layout>

<style>
  /* Hub-scoped visual language — same red/green/amber system as /roadmap. */
  .hub-scope {
    --red: #ff2d3d;
    --red-glow: rgba(255, 45, 61, 0.25);
    --amber: #ffb020;
    --green: #22ff66;
    --ink-dim: #8a8a99;
    /* #55555f measured 2.37:1 on --card and 2.62:1 on the page ground — both
       below the WCAG 1.4.3 AA floor of 4.5:1 for body copy. #8a8a99 measures
       5.12:1 on --card and 5.61:1 on the ground. It is the dimmest grey in
       this palette that still clears 4.5:1 against --card, which is why it
       lands on the same value as --ink-dim. */
    --ink-mute: #8a8a99;
    --line: #24242f;
    --card: #191922;
    position: relative;
    isolation: isolate;
  }

  .hub-scope .scanlines {
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgba(255, 255, 255, 0.014) 2px 3px
    );
    pointer-events: none;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hub-scope .scanlines { display: none; }
  }

  .hub-scope .hairline-red { background: var(--red); }

  .hub-scope .brand-display {
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 8px 0 0;
    text-transform: uppercase;
    color: #e8e8ee;
  }
  .hub-scope .brand-display .red { color: var(--red); }

  .hub-scope .lede {
    max-width: 640px;
    margin: 20px 0 8px;
    font-size: 17px;
    line-height: 1.6;
  }
  .hub-scope .lede-link {
    color: var(--red);
    text-decoration: none;
    border-bottom: 1px solid var(--red);
  }
  .hub-scope .lede-link:hover,
  .hub-scope .lede-link:focus-visible { color: #fff; border-bottom-color: #fff; }

  .hub-scope .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 28px 0 32px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    list-style: none;
  }
  .hub-scope .stat { padding: 4px 0; }
  .hub-scope .stat b {
    display: block;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 34px;
    color: var(--red);
    line-height: 1;
  }
  .hub-scope .stat span {
    display: block;
    font-size: 11px;
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 6px;
  }

  .hub-scope .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
  }

  .hub-scope .tile {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 220px;
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }
  .hub-scope .tile-live {
    border-color: rgba(34, 255, 102, 0.35);
    box-shadow: 0 0 20px rgba(34, 255, 102, 0.10);
  }
  .hub-scope .tile-next {
    border-color: rgba(255, 176, 32, 0.35);
  }
  .hub-scope .tile:hover,
  .hub-scope .tile:focus-within {
    transform: translateY(-1px);
  }
  .hub-scope .tile-live:hover { box-shadow: 0 0 24px rgba(34, 255, 102, 0.20); }

  .hub-scope .tile-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
  }
  .hub-scope .pip {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--ink-mute);
    box-shadow: 0 0 0 2px rgba(0,0,0,0.5);
    flex: none;
  }
  .hub-scope .pip-live {
    background: var(--green);
    box-shadow: 0 0 0 2px rgba(0,0,0,0.5), 0 0 10px var(--green);
    animation: hub-pulse 2.4s ease-in-out infinite;
  }
  .hub-scope .pip-next {
    background: var(--amber);
    box-shadow: 0 0 0 2px rgba(0,0,0,0.5), 0 0 8px var(--amber);
  }
  .hub-scope .pip-upcoming {
    background: var(--red);
  }
  @keyframes hub-pulse {
    0%, 100% { box-shadow: 0 0 0 2px rgba(0,0,0,0.5), 0 0 6px var(--green); }
    50%      { box-shadow: 0 0 0 2px rgba(0,0,0,0.5), 0 0 14px var(--green); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hub-scope .pip-live { animation: none; }
    .hub-scope .tile { transition: none; }
    .hub-scope .tile:hover, .hub-scope .tile:focus-within { transform: none; }
  }

  .hub-scope .tile-status { font-weight: 700; color: #e8e8ee; }
  .hub-scope .tile-live .tile-status { color: var(--green); }
  .hub-scope .tile-next .tile-status { color: var(--amber); }
  .hub-scope .tile-date { margin-left: auto; color: var(--ink-mute); }

  .hub-scope .tile-name {
    margin: 4px 0 0;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: #e8e8ee;
    line-height: 1.05;
  }
  .hub-scope .tile-blurb {
    color: var(--ink-dim);
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .hub-scope .tile-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 6px;
  }
  .hub-scope .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    font-family: 'Impact', 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    border-radius: 3px;
    text-decoration: none;
    border: 1px solid currentColor;
    transition: background 150ms ease, color 150ms ease;
  }
  .hub-scope .btn-launch {
    background: var(--green);
    color: #000;
    border-color: var(--green);
  }
  .hub-scope .btn-launch:hover,
  .hub-scope .btn-launch:focus-visible {
    background: #fff;
    color: #000;
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
  .hub-scope .btn-notify {
    color: var(--red);
    background: transparent;
  }
  .hub-scope .btn-notify:hover,
  .hub-scope .btn-notify:focus-visible {
    background: var(--red);
    color: #000;
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  .hub-scope .foot-note {
    margin: 32px 0 0;
    color: var(--ink-mute);
    font-size: 12px;
  }
  .hub-scope .foot-note code {
    background: var(--card);
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 11px;
  }
</style>
