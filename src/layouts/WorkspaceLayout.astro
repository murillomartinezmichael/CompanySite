---
import '@/styles/global.css';import '@/styles/redesign.css';import '@/styles/workspace.css';
import {WORKSPACE_VIEWS,workspaceHref} from '@/config/workspace';
interface Props {view:typeof WORKSPACE_VIEWS[number];}
const {view}=Astro.props;
const groups=[['Overview',['']],['Assets',['silver','brokerage','cds']],['Records',['investor-ledger','activity']],['Planning',['budget-goals','operations']]] as const;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="referrer" content="no-referrer"/><title>{view.title+' — M3MM Workspace'}</title><meta name="description" content="Owner-only M3MM workspace. No public financial information."/><link rel="icon" href="/official-logo.png"/><style is:inline>@font-face{font-family:Inter;font-style:normal;font-weight:400 600;font-display:swap;src:url('/fonts/inter-latin.woff2') format('woff2')}@font-face{font-family:'Space Grotesk';font-style:normal;font-weight:300 700;font-display:swap;src:url('/fonts/space-grotesk-latin.woff2') format('woff2')}</style><script is:inline>try{var theme=localStorage.getItem('m3mm-theme');if(theme==='dark'||theme==='light')document.documentElement.dataset.theme=theme;}catch{}</script></head>
<body class="m3-redesign m3-workspace"><a href="#main" class="ws-skip">Skip to content</a><header class="ws-top"><a href="/" class="ws-brand"><img src="/official-logo.png" width="40" height="40" alt=""/><span>M3MM <small>Private workspace</small></span></a><div class="ws-top-actions"><span class="ws-owner-label">Owner-only area</span><button type="button" id="ws-theme" aria-label="Switch color theme">Theme</button><button type="button" id="ws-menu" aria-expanded="false" aria-controls="ws-nav" hidden>Navigation</button><a href="/">Company website ↗</a></div></header>
<div class="ws-frame"><aside class="ws-sidebar" id="ws-nav"><nav aria-label="Private workspace">{groups.map(([label,slugs])=><section><h2>{label}</h2>{slugs.map(slug=>{const item=WORKSPACE_VIEWS.find(v=>v.slug===slug)!;const active=slug?view.slug===slug||view.slug.startsWith(slug+'/'):view.slug==='';return <a href={workspaceHref(slug)} aria-current={active?'page':undefined}>{item.title==='Finance overview'?'Overview':item.title==='Certificates of deposit'?'CDs':item.title}</a>;})}</section>)}</nav><p class="ws-sidebar-note">Private records are never included in public pages. Investor access is not enabled.</p></aside>
<main id="main" class="ws-main"><header class="ws-heading"><p class="m3-eyebrow">Workspace / {view.group}</p><h1>{view.title}</h1><p>{view.intro}</p></header><div id="finance-app" data-view={view.slug}><p class="ws-notice" role="status">Waiting for authenticated data. No records are embedded in this page.</p></div><noscript><p class="ws-notice">JavaScript is required for interactive finance views. Owner authorization is still enforced by the server.</p></noscript><footer class="ws-footer">Private records · No trading or money movement · No public analytics</footer></main></div>
<script>
import {mountFinance} from '@/lib/finance/ui';mountFinance();
const menu=document.querySelector<HTMLButtonElement>('#ws-menu');const nav=document.getElementById('ws-nav');if(menu&&nav){menu.hidden=false;nav.dataset.enhanced='true';menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav.toggleAttribute('data-open',open);});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.getAttribute('aria-expanded')==='true'){menu.setAttribute('aria-expanded','false');nav.removeAttribute('data-open');menu.focus();}});}
document.getElementById('ws-theme')?.addEventListener('click',()=>{const current=document.documentElement.dataset.theme||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');const next=current==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('m3mm-theme',next);}catch{}});
</script></body></html>
