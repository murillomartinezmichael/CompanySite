---
import designTokens from '../../tailwind.config.mjs';
import '@/styles/global.css';
// Claude-powered assistant, replaced the SiteGuide embed 2026-08-20.
import ChatWidget from '@/components/ChatWidget.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}
interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

// Default OG image is now the PNG raster of og.svg. SVG OG cards silently
// fail on iMessage / WhatsApp / LinkedIn — the primary re-share paths from
// TikTok DMs — even though Twitter, Discord, and Slack render them fine.
// Ship PNG as the source of truth; SVG stays in /public as a fallback.
const {
  title = 'M3MM — Modernize. Mobilize. Multiply.',
  description = 'M3MM is Michael Murillo-Martinez\'s company hub for the official release, test deployments, client work, company departments, policies, and roadmap.',
  path = '/',
  ogImage = '/official-logo.png',
  noindex = false,
  breadcrumbs,
} = Astro.props;

const canonical = new URL(path, Astro.site ?? 'https://m3mm.net').toString();

// CONVERSION_STANDARDS.md § 1 — no dead-end CTAs. Only `/websites`, `/audit`, and
// the `/for/*` trade pages mount <Intake>; on those pages the sticky CTA is
// a same-page anchor. On any other page (`/thanks`, `/accessibility`,
// future pages) the bare `/audit` fallback lands the visitor at the top of
// the review page and leaves the promise ("Free review") one scroll short
// of the form. Cross-navigate to `/audit#intake` — same pattern as
// Header/Footer's intakeHref (tick-20), pinned by tests/build/intake-cta.test.ts.
const hasIntakeOnPage = path === '/websites' || path === '/audit' || path === '/start' || path.startsWith('/for/');
const stickyIntakeHref = hasIntakeOnPage ? '#intake' : '/audit#intake';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={designTokens.theme.extend.colors.ink.DEFAULT} />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Michael Murillo-Martinez" />
    <link rel="canonical" href={canonical} />

    {noindex ? (
      <meta name="robots" content="noindex,nofollow" />
    ) : (
      <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, canonical).toString()} />
    <meta property="og:image:width" content={ogImage === '/official-logo.png' ? '1024' : '1200'} />
    <meta property="og:image:height" content={ogImage === '/official-logo.png' ? '1024' : '630'} />
    <meta property="og:image:type" content={ogImage.endsWith('.svg') ? 'image/svg+xml' : 'image/png'} />
    <meta property="og:image:alt" content={ogImage === '/official-logo.png' ? 'M3MM official logo' : title} />
    <meta name="twitter:card" content={ogImage === '/official-logo.png' ? 'summary' : 'summary_large_image'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonical).toString()} />

    <link rel="icon" type="image/png" href="/official-logo.png" />
    <link rel="apple-touch-icon" href="/official-logo.png" />

    <!--
      Self-hosted fonts. Inter (400/500/600) and Space Grotesk (300–700) each
      ship as ONE variable woff2 (latin subset), so 2 files cover all 8
      declared weights. Same-origin, so there is no Google Fonts CSS round
      trip and no gstatic/googleapis handshakes. font-mono falls back to
      ui-monospace.
    -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 600;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'M3MM',
      logo: 'https://m3mm.net/brand-mark.png',
      url: 'https://m3mm.net/',
      description,
      areaServed: 'United States',
      founder: { '@type': 'Person', name: 'Michael Murillo-Martinez' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Atlanta',
        addressRegion: 'GA',
        addressCountry: 'US',
      },
      // Contact via intake form. Raw email in HTML triggers Cloudflare's
      // Email Address Obfuscation, which injects cdn-cgi/scripts/…/
      // email-decode.min.js on every page and adds a same-origin RTT under
      // simulated mobile throttling. Perf/lh-mobile-baseline-tick7-… flagged
      // it in the network trace; routing contact through the intake URL
      // drops that resource without losing schema.org contact discoverability.
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        url: 'https://m3mm.net/audit',
        availableLanguage: 'English',
      },
      knowsAbout: ['Web development', 'Automation', 'Small business websites', 'Lead generation'],
      // Structured pricing so Google can show tiered offers in search
      // results ("Atlanta website cost" queries). Mirrors the four
      // Service.astro tiers verbatim; keep this in sync whenever pricing
      // changes there. Quote-only tier omits price per Google's guidance
      // that missing price is preferable to placeholder 0.
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'M3MM website services',
        itemListElement: [
          {
            '@type': 'Offer',
            name: 'Basic site or cleanup',
            description: 'One-page site, landing page, or refresh — mobile-first, clear CTA, contact path wired.',
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              priceCurrency: 'USD',
              price: 500,
              minPrice: 500,
            },
            availability: 'https://schema.org/InStock',
            url: 'https://m3mm.net/start',
          },
          {
            '@type': 'Offer',
            name: 'Business website package',
            description: 'Full custom business site with positioning, proof, service sections, and lead capture.',
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              priceCurrency: 'USD',
              price: 1000,
              minPrice: 1000,
              maxPrice: 2000,
            },
            availability: 'https://schema.org/InStock',
            url: 'https://m3mm.net/websites#services',
          },
          {
            '@type': 'Offer',
            name: 'SiteGuide setup + customization',
            description: 'Brand a SiteGuide starter template, configure the AI guide widget, wire launch, hand off.',
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              priceCurrency: 'USD',
              price: 500,
              minPrice: 500,
            },
            availability: 'https://schema.org/InStock',
            url: 'https://m3mm.net/websites#services',
          },
          {
            '@type': 'Offer',
            name: 'Premium custom company build',
            description: 'Large company site, multi-page service-line build, portal, or integration — quote-only.',
            availability: 'https://schema.org/InStock',
            url: 'https://m3mm.net/websites#services',
          },
        ],
      },
    })} />

    {breadcrumbs && breadcrumbs.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(b.url, 'https://m3mm.net').toString(),
        })),
      })} />
    )}
  </head>
  <body class:list={[{ 'hq-page': path === '/' || path === '/websites' }]}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-clay focus:px-4 focus:py-2 focus:text-ink">Skip to content</a>

    <slot name="header" />

    <main id="main" data-page={path}>
      {breadcrumbs && breadcrumbs.length > 1 && (
        <nav class="page-trail container-page" aria-label="Breadcrumb">
          <ol>{breadcrumbs.map((crumb, index) => <li>
            {index < breadcrumbs.length - 1
              ? <a href={crumb.url} data-cta="breadcrumb" data-section="navigation">{crumb.name}</a>
              : <span aria-current="page">{crumb.name}</span>}
          </li>)}</ol>
        </nav>
      )}
      <slot />
    </main>

    <slot name="footer" />

    <!-- Sticky mobile CTA. Mobile-only; the Header nav covers desktop. -->
    <nav aria-label="Quick contact">
    <a
      id="sticky-cta"
      href={stickyIntakeHref}
      class="sticky-cta lg:hidden"
      data-cta="sticky-mobile"
      data-section="sticky"
      data-intent="book:free-review"
      aria-label="Get a free site review"
    >
      <span>Free review</span>
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    </nav>

    <script is:inline>
      // Reveal past the hero fold; hide again once the intake is within one
      // viewport of the top so the button never overlaps the form itself.
      (function () {
        var el = document.getElementById('sticky-cta');
        if (!el) return;
        var intake = document.getElementById('intake');
        function tick() {
          var y = window.scrollY || window.pageYOffset;
          var shouldShow = y > 260;
          if (intake) {
            var rect = intake.getBoundingClientRect();
            var vh = window.innerHeight || document.documentElement.clientHeight;
            // Hide when the intake form is within one screen height of the top.
            if (rect.top < vh * 1.1) shouldShow = false;
          }
          el.classList.toggle('is-visible', shouldShow);
        }
        tick();
        window.addEventListener('scroll', tick, { passive: true });
        window.addEventListener('resize', tick, { passive: true });
      })();
    </script>

    <script>
      import { wireMotion } from '@/lib/motion';
      import { wireCTAs } from '@/lib/track';
      import { wirePrefill } from '@/lib/prefill';
      import { wireLazyVideos } from '@/lib/lazyVideo';
      wireMotion();
      wireCTAs();
      wirePrefill();
      wireLazyVideos();
    </script>

    <ChatWidget />
  </body>
</html>
