---
import {PUBLIC_PROJECTS, statusLabel} from '@/config/public-projects';
const selected=[PUBLIC_PROJECTS[1],PUBLIC_PROJECTS[4],PUBLIC_PROJECTS[5]];
---
<div class="m3-grid">{selected.map(p=><article class="m3-card"><span class="m3-status" data-status={p.status}>{statusLabel(p.status)}</span><h3>{p.name}</h3><p>{p.blurb}</p><a class="m3-link" href={'/projects/'+p.slug} data-cta="selected-project" data-section="projects">Explore the project →</a></article>)}</div>
