---
// Trade-vertical landing hero — competitor research 2026-07-19 (high/M
// positioning): Footbridge names 15 trade verticals, Hook targets
// roofing/HVAC explicitly; our proof is already contractors but the copy
// sold to a generic "business". Each /for/* page is the deep-link target
// for a trade-specific TikTok/IG video so message match holds end-to-end.
// Proof panels carry the SAME verified client facts as Hero + /audit +
// /thanks — no trade gets an invented outcome.
interface ProofPanel {
  name: string;
  accent: 'cyber' | 'neon';
  pre: string;
  strong: string;
  post: string;
}
interface Props {
  trade: string; // slug — becomes the data-section funnel bucket (for-<trade>)
  kicker: string;
  headline: string;
  headlineDim: string;
  sub: string;
  proofs: ProofPanel[];
}
const { trade, kicker, headline, headlineDim, sub, proofs } = Astro.props;

// The owner-approved lime/blue palette shares the existing caller keys.
---

<section class="page-intro trade-intro container-page m3-hero"><div><p class="m3-eyebrow">{kicker}</p><h1>{headline} <span>{headlineDim}</span></h1><p class="m3-lede">{sub}</p><div class="m3-actions"><a href="#intake" class="m3-button primary" data-cta="trade-review" data-section={`for-${trade}`} data-intent="book:free-review">Get my free teardown →</a><a href="/websites?intent=product:case-studies#proof" class="m3-link" data-cta="trade-see-work" data-section={`for-${trade}`} data-intent="product:case-studies">See the full case studies</a></div><p class="m3-lede">No sales call · Recorded video teardown, not a template · 24h reply, personally · Free—actually free</p></div><aside class="m3-manifesto" aria-label="Relevant client evidence">{proofs.map(p=><div><span>Relevant work</span><strong>{p.name}</strong><p>{p.pre} <b>{p.strong}</b>{p.post}</p></div>)}</aside></section>
