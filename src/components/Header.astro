---
interface Props {minimal?:boolean;path?:string;}
const {path='/'}=Astro.props;
const links=[['/','Home'],['/services','Services'],['/projects','Projects'],['/roadmaps','Roadmaps'],['/about','About'],['/contact','Contact']];
const active=(href:string)=>href==='/'?path==='/':href==='/services'?['/websites','/audit','/start'].includes(path)||path.startsWith('/for/')||path.startsWith('/services'):href==='/roadmaps'?path.startsWith('/roadmap'):href==='/about'?['/about','/resume'].includes(path):path.startsWith(href);
---
<header class="hub-header m3-header"><div class="container-page m3-header-inner">
<a class="m3-brand" href="/" aria-label="M3MM home" data-cta="logo" data-section="header"><img src="/official-logo.png" width="44" height="44" alt="" decoding="async"/><span>M3MM<small>Modernize. Mobilize. Multiply.</small></span></a>
<nav id="company-navigation" aria-label="Primary">{links.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined} data-cta={'nav-'+label.toLowerCase()} data-section="header">{label}</a>)}</nav>
<div class="m3-header-controls"><button class="theme-toggle" type="button" data-theme-toggle data-cta="header-theme-toggle" data-section="header" aria-label="Switch to light mode"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.7"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1" stroke="currentColor" stroke-width="1.7"/></svg></button><button class="m3-menu" type="button" aria-expanded="false" aria-controls="company-navigation" data-cta="mobile-menu" data-section="header" hidden>Menu</button></div>
</div></header>
<script>
  // Light/dark toggle. The saved choice is applied before paint in Layout.astro;
  // this only flips it and keeps the label honest about what a click will do.
  const root = document.documentElement;
  const osLight = matchMedia('(prefers-color-scheme: light)');
  const current = () => root.dataset.theme ?? (osLight.matches ? 'light' : 'dark');
  const sync = () => {
    const next = current() === 'light' ? 'dark' : 'light';
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.setAttribute('aria-label', `Switch to ${next} mode`);
      button.title = `Switch to ${next} mode`;
    }
  };
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = current() === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('m3mm-theme', next); } catch {}
      sync();
      window.dispatchEvent(new CustomEvent('m3mm:themechange'));
    });
  }
  osLight.addEventListener('change', () => { sync(); window.dispatchEvent(new CustomEvent('m3mm:themechange')); });
  sync();

const menu=document.querySelector<HTMLButtonElement>('.m3-menu');
const nav=document.getElementById('company-navigation');
if(menu&&nav){menu.hidden=false;nav.dataset.enhanced='true';const close=()=>{menu.setAttribute('aria-expanded','false');nav.removeAttribute('data-open');};menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav.toggleAttribute('data-open',open);});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.getAttribute('aria-expanded')==='true'){close();menu.focus();}});nav.addEventListener('click',e=>{if((e.target as Element).closest('a'))close();});matchMedia('(min-width: 1001px)').addEventListener('change',close);}
</script>
<style>
.m3-header{position:sticky;top:0;z-index:40;background:rgb(var(--ink)/.97);border-bottom:1px solid rgb(var(--ink-line))}.m3-header-inner{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:88px;padding-block:.8rem}.m3-brand{display:flex;gap:.7rem;align-items:center;flex-shrink:0}.m3-brand img{width:44px;height:44px;object-fit:contain}.m3-brand span{font:600 1.3rem/1.2 'Space Grotesk',sans-serif}.m3-brand small{display:block;font:400 .625rem/1.5 Inter,sans-serif;color:rgb(var(--bone-muted));margin-top:.3rem;letter-spacing:.01em}nav{display:flex;align-items:center;gap:1.5rem}nav a{display:flex;min-height:44px;align-items:center;font-size:.875rem;color:rgb(var(--bone-dim));border-bottom:2px solid transparent}nav a[aria-current=page]{color:rgb(var(--bone));border-color:rgb(var(--clay))}nav a:hover{color:rgb(var(--electric))}.m3-header-controls{display:flex;gap:.6rem}.theme-toggle,.m3-menu{height:44px;min-width:44px;display:grid;place-items:center;border:1px solid rgb(var(--ink-outline));border-radius:8px;background:transparent;color:rgb(var(--bone));font-size:.85rem}.m3-menu{display:none;padding-inline:1rem}@media(max-width:1000px){.m3-header-inner{flex-wrap:wrap;min-height:76px;gap:.5rem}.m3-header-controls{margin-left:auto}.m3-menu:not([hidden]){display:grid}nav{order:3;width:100%;flex-wrap:wrap;gap:.25rem 1.5rem;padding-block:.5rem}nav[data-enhanced]:not([data-open]){display:none}nav[data-open]{display:grid;grid-template-columns:1fr 1fr}nav a{padding:.5rem .75rem}nav a[aria-current=page]{background:rgb(var(--ink-soft));border-radius:5px}.m3-brand small{font-size:.6rem}}@media(max-width:400px){.m3-brand small{display:none}}
</style>
