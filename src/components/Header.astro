---
interface Props {
  minimal?: boolean;
  path?: string;
}
const { minimal = false, path = '/' } = Astro.props;

// CONVERSION_STANDARDS.md § 1 — no dead-end CTAs. The website department,
// `/audit`, `/start`, and the `/for/*` trade pages render <Intake>, so `#intake` on any other
// page scrolls to the top — a broken promise. Route those clicks to
// `/audit#intake` instead so the CTA actually lands the visitor in the form.
const hasIntakeOnPage = path === '/websites' || path === '/audit' || path === '/start' || path.startsWith('/for/');
const intakeHref = hasIntakeOnPage ? '#intake' : '/audit#intake';
const isHubHome = path === '/';
---

<header class="relative z-30">
  <div class="container-page flex items-center justify-between py-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label="M3MM home" data-cta="logo" data-section="header">
      <span
        class="grid h-9 w-9 place-items-center overflow-hidden bg-ink-soft ring-1 ring-ink-line transition-all group-hover:ring-clay/60"
        style="border-radius: 2px;"
      >
        <!-- mark-light.png, not brand-mark.svg: the SVG paints #0a0a0a on this
             #161A24 tile (~1.13:1) so it renders as an empty square, and
             docs/brand-ownership.md calls it the rough vector draft. This is the
             light-on-dark master, the same file Footer and Intake already use. -->
        <img
          src="/mark-light.png"
          alt=""
          width="28"
          height="28"
          class="h-7 w-7 object-contain"
          decoding="async"
        />
      </span>
      <span class="hidden font-mono text-[11px] uppercase tracking-[0.16em] text-bone-muted sm:inline">Modernize. Mobilize. Multiply.</span>
    </a>

    {!minimal && isHubHome && (
      <nav class="hidden items-center gap-8 text-sm text-bone-dim md:flex" aria-label="Primary">
        <a href="#released" class="transition-colors hover:text-bone" data-cta="nav-released" data-section="header" data-intent="product:released-work">Released</a>
        <a href="#roadmap" class="transition-colors hover:text-bone" data-cta="nav-roadmap" data-section="header" data-intent="product:roadmap">Roadmap</a>
        <a href="/resume" class="transition-colors hover:text-bone" data-cta="nav-resume" data-section="header" data-intent="product:career">Resume</a>
        <a href="/policies" class="transition-colors hover:text-bone" data-cta="nav-policies" data-section="header" data-intent="product:company-policies">Policies</a>
      </nav>
    )}

    {!minimal && !isHubHome && (
      <nav class="hidden items-center gap-8 text-sm text-bone-dim md:flex" aria-label="Primary">
        <a href="#proof" class="transition-colors hover:text-bone" data-cta="nav-proof" data-section="header">Work</a>
        <a href="#services" class="transition-colors hover:text-bone" data-cta="nav-services" data-section="header">Services</a>
        <a href={intakeHref} class="transition-colors hover:text-bone" data-cta="nav-intake" data-section="header" data-intent="book:free-review">Contact</a>
      </nav>
    )}

    {/*
      2026-08-19: the hub-home CTA used to be "Website services ▸" -> /websites.
      m3mm.net is the main COMPANY page, so the website-services department no
      longer advertises itself from the company chrome. Both branches now offer
      the same free review. /websites still exists and still builds; it is only
      unlinked from here. Restore by reinstating the isHubHome branch.
    */}
    {(
      <a
        href={intakeHref}
        class="inline-flex items-center gap-1.5 border border-clay bg-clay px-4 py-2 text-sm font-semibold text-ink transition-all duration-150 hover:bg-clay-glow hover:border-clay-glow hover:shadow-glow-clay"
        style="border-radius: 6px; letter-spacing: 0.01em;"
        data-cta="header-review"
        data-section="header"
        data-intent="book:free-review"
      >
        Free review ▸
      </a>
    )}
  </div>
</header>
