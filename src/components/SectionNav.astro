---
interface Props {
  label: string;
  section: string;
  links: { label: string; href: string; cta: string; intent: string }[];
}
const { label, section, links } = Astro.props;
---

<nav aria-label={label} class="section-nav">
  <p>{label}</p>
  <ul role="list">
    {links.map(link => (
      <li><a href={link.href} data-cta={link.cta} data-section={section} data-intent={link.intent}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .section-nav { margin-block: 2rem; border-block: 1px solid theme('colors.ink.line'); padding-block: 1rem; }
  p { @apply text-hq-small; color: theme('colors.bone.dim'); margin-bottom: .5rem; }
  ul { display: flex; flex-wrap: wrap; gap: .5rem; }
  a { @apply text-hq-small; display: inline-flex; align-items: center; min-height: 44px; padding: .5rem .875rem; background: theme('colors.ink.soft'); border: 1px solid theme('colors.ink.line'); border-radius: theme('borderRadius.hq-control'); color: theme('colors.electric.DEFAULT'); text-decoration: underline; text-underline-offset: .25em; }
  a:hover { color: theme('colors.electric.glow'); }
</style>
