---
// Claude-powered assistant widget — replaces the SiteGuide embed (2026-08-20).
// Owned end-to-end: UI here, backend at functions/api/chat.ts. Fixed
// bottom-right, matching where the SiteGuide badge sat. The site's own
// "Free review" sticky CTA lives at bottom-left (see global.css .sticky-cta)
// specifically to stay clear of this corner — don't move this without
// checking that comment first.
---

<div id="chat-widget" class="chat-widget">
  <button
    type="button"
    id="chat-trigger"
    class="chat-trigger"
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label="Open assistant chat"
    data-cta="chat-widget-open"
    data-section="chat-widget"
  >
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="chat-trigger-icon-open">
      <path d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H8l-4 3v-3H5a2 2 0 0 1-2-2V5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="chat-trigger-icon-close">
      <path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    </svg>
  </button>

  <div id="chat-panel" class="chat-panel" role="dialog" aria-label="M3MM assistant" aria-modal="false" hidden>
    <div class="chat-panel-head">
      <div class="chat-panel-title">
        <span class="chat-panel-dot" aria-hidden="true"></span>
        <span>Ask M3MM</span>
      </div>
      <button type="button" id="chat-close" class="chat-panel-close" aria-label="Close chat">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>

    <div id="chat-messages" class="chat-messages" role="log" aria-live="polite" aria-label="Conversation">
      <div class="chat-msg chat-msg-assistant">
        Hey — I'm the M3MM assistant. Ask me about pricing, what a project looks like, or anything else. Want the fastest path in? Try the <a href="/audit#intake" data-cta="chat-widget-review-link" data-section="chat-widget" data-intent="book:free-review">free review</a>.
      </div>
    </div>

    <form id="chat-form" class="chat-form">
      <label class="sr-only" for="chat-input">Message</label>
      <textarea
        id="chat-input"
        name="message"
        rows="1"
        maxlength="4000"
        placeholder="Ask a question…"
        autocomplete="off"
      ></textarea>
      <button type="submit" id="chat-send" class="chat-send" aria-label="Send message">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h11m0 0L8 3m5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>
  </div>
</div>

<style>
  .chat-widget { position: fixed; right: 16px; bottom: 16px; z-index: 60; }

  .chat-trigger {
    display: grid; place-items: center;
    width: 52px; height: 52px;
    border-radius: 999px;
    background: theme('colors.clay.DEFAULT');
    color: theme('colors.ink.DEFAULT');
    border: 1px solid theme('colors.clay.DEFAULT');
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    cursor: pointer;
    transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
  }
  .chat-trigger:hover, .chat-trigger:focus-visible {
    background: theme('colors.clay.glow');
    border-color: theme('colors.clay.glow');
  }
  .chat-trigger svg { width: 22px; height: 22px; }
  .chat-trigger-icon-close { display: none; }
  .chat-widget.is-open .chat-trigger-icon-open { display: none; }
  .chat-widget.is-open .chat-trigger-icon-close { display: block; }

  .chat-panel {
    position: absolute;
    right: 0;
    bottom: 64px;
    width: min(360px, calc(100vw - 32px));
    height: min(520px, calc(100vh - 120px));
    display: flex;
    flex-direction: column;
    background: theme('colors.ink.soft');
    border: 1px solid theme('colors.ink.line');
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }
  .chat-panel[hidden] { display: none; }

  .chat-panel-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid theme('colors.ink.line');
    background: theme('colors.ink.panel');
  }
  .chat-panel-title {
    display: flex; align-items: center; gap: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: theme('colors.bone.DEFAULT');
  }
  .chat-panel-dot {
    width: 7px; height: 7px; border-radius: 999px;
    background: theme('colors.clay.DEFAULT');
    box-shadow: 0 0 8px theme('colors.clay.DEFAULT');
  }
  .chat-panel-close {
    display: grid; place-items: center;
    width: 28px; height: 28px;
    border-radius: 6px;
    color: theme('colors.bone.muted');
    background: transparent; border: none; cursor: pointer;
  }
  .chat-panel-close:hover, .chat-panel-close:focus-visible { color: theme('colors.bone.DEFAULT'); background: theme('colors.ink.line'); }
  .chat-panel-close svg { width: 16px; height: 16px; }

  .chat-messages {
    flex: 1; overflow-y: auto;
    padding: 16px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .chat-msg {
    max-width: 88%;
    padding: 9px 12px;
    border-radius: 10px;
    font-size: 13.5px; line-height: 1.5;
    color: theme('colors.bone.dim');
    word-wrap: break-word;
  }
  .chat-msg a { color: theme('colors.clay.DEFAULT'); text-decoration: underline; text-underline-offset: 3px; }
  .chat-msg-assistant { align-self: flex-start; background: theme('colors.ink.panel'); border: 1px solid theme('colors.ink.line'); }
  .chat-msg-user { align-self: flex-end; background: theme('colors.clay.DEFAULT'); color: theme('colors.ink.DEFAULT'); }
  .chat-msg-error { align-self: flex-start; background: rgba(255, 60, 60, 0.08); border: 1px solid rgba(255, 60, 60, 0.35); color: theme('colors.bone.dim'); }
  .chat-msg-pending::after {
    content: ''; display: inline-block; width: 6px; height: 6px; margin-left: 4px;
    border-radius: 999px; background: currentColor; opacity: 0.6;
    animation: chat-pulse 1s ease-in-out infinite;
  }
  @keyframes chat-pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.9; } }
  @media (prefers-reduced-motion: reduce) {
    .chat-msg-pending::after { animation: none; }
  }

  .chat-form {
    display: flex; align-items: flex-end; gap: 8px;
    padding: 12px;
    border-top: 1px solid theme('colors.ink.line');
    background: theme('colors.ink.panel');
  }
  .chat-form textarea {
    flex: 1; resize: none;
    max-height: 96px;
    padding: 9px 11px;
    border-radius: 8px;
    background: theme('colors.ink.DEFAULT');
    border: 1px solid theme('colors.ink.line');
    color: theme('colors.bone.DEFAULT');
    font-family: inherit; font-size: 13.5px; line-height: 1.4;
  }
  .chat-form textarea:focus-visible { outline: 2px solid theme('colors.clay.DEFAULT'); outline-offset: 1px; }
  .chat-send {
    display: grid; place-items: center;
    width: 36px; height: 36px; flex: none;
    border-radius: 8px;
    background: theme('colors.clay.DEFAULT');
    color: theme('colors.ink.DEFAULT');
    border: none; cursor: pointer;
  }
  .chat-send:hover, .chat-send:focus-visible { background: theme('colors.clay.glow'); }
  .chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
  .chat-send svg { width: 16px; height: 16px; }

  @media (max-width: 480px) {
    .chat-widget { right: 12px; bottom: 12px; }
    .chat-panel { width: calc(100vw - 24px); right: -4px; }
  }
</style>

<script>
  type ChatRole = 'user' | 'assistant';
  type ChatMessage = { role: ChatRole; content: string };

  const widget = document.getElementById('chat-widget');
  const trigger = document.getElementById('chat-trigger') as HTMLButtonElement | null;
  const panel = document.getElementById('chat-panel');
  const closeBtn = document.getElementById('chat-close') as HTMLButtonElement | null;
  const messagesEl = document.getElementById('chat-messages');
  const form = document.getElementById('chat-form') as HTMLFormElement | null;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement | null;
  const sendBtn = document.getElementById('chat-send') as HTMLButtonElement | null;

  if (widget && trigger && panel && closeBtn && messagesEl && form && input && sendBtn) {
    const history: ChatMessage[] = [];
    const MAX_HISTORY = 20; // must match MAX_HISTORY_MESSAGES in functions/api/chat.ts
    let opened = false;
    let inFlight = false;

    function openPanel() {
      opened = true;
      widget!.classList.add('is-open');
      trigger!.setAttribute('aria-expanded', 'true');
      panel!.hidden = false;
      input!.focus();
    }
    function closePanel() {
      opened = false;
      widget!.classList.remove('is-open');
      trigger!.setAttribute('aria-expanded', 'false');
      panel!.hidden = true;
      trigger!.focus();
    }

    trigger.addEventListener('click', () => (opened ? closePanel() : openPanel()));
    closeBtn.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && opened) closePanel();
    });

    // Auto-grow the textarea up to its max-height, no library.
    input.addEventListener('input', () => {
      input!.style.height = 'auto';
      input!.style.height = `${input!.scrollHeight}px`;
    });

    function appendMessage(role: ChatRole | 'error', text: string, pending = false): HTMLDivElement {
      const el = document.createElement('div');
      el.className = `chat-msg chat-msg-${role}${pending ? ' chat-msg-pending' : ''}`;
      el.textContent = text;
      messagesEl!.appendChild(el);
      messagesEl!.scrollTop = messagesEl!.scrollHeight;
      return el;
    }

    async function send(message: string) {
      if (inFlight) return;
      inFlight = true;
      sendBtn!.disabled = true;

      history.push({ role: 'user', content: message });
      // Stay within the backend's message cap, trimming whole user/assistant
      // pairs so the window still starts on a user turn (the API requires it).
      while (history.length > MAX_HISTORY) history.splice(0, 2);
      appendMessage('user', message);

      const replyEl = appendMessage('assistant', '', true);
      let replyText = '';
      let assistantCommitted = false;

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });

        if (!res.ok || !res.body) {
          replyEl.classList.remove('chat-msg-pending');
          replyEl.classList.add('chat-msg-error');
          replyEl.textContent = res.status === 429
            ? "I'm getting a lot of questions right now — try again in a moment."
            : 'Something broke on my end. Try the free review form instead, or email murillomartinezmichael@gmail.com.';
          return;
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });

          let newlineIndex: number;
          while ((newlineIndex = buffer.indexOf('\n')) !== -1) {
            const line = buffer.slice(0, newlineIndex);
            buffer = buffer.slice(newlineIndex + 1);
            if (!line.trim()) continue;

            try {
              const event = JSON.parse(line) as { type: string; text?: string; message?: string };
              if (event.type === 'delta' && event.text) {
                replyText += event.text;
                replyEl.classList.remove('chat-msg-pending');
                replyEl.textContent = replyText;
                messagesEl!.scrollTop = messagesEl!.scrollHeight;
              } else if (event.type === 'error') {
                replyEl.classList.remove('chat-msg-pending');
                if (!replyText) {
                  replyEl.classList.add('chat-msg-error');
                  replyEl.textContent = event.message || 'Something went wrong.';
                }
              } else if (event.type === 'done') {
                replyEl.classList.remove('chat-msg-pending');
              }
            } catch {
              // Malformed line — skip it, don't break the whole stream.
            }
          }
        }

        if (replyText) {
          history.push({ role: 'assistant', content: replyText });
          assistantCommitted = true;
        }
      } catch {
        replyEl.classList.remove('chat-msg-pending');
        replyEl.classList.add('chat-msg-error');
        replyEl.textContent = 'Connection dropped. Try again, or use the free review form.';
      } finally {
        // No assistant reply landed (error / 429 / dropped stream): drop the
        // just-sent user turn so history stays strictly alternating. Otherwise
        // the next send posts two user roles in a row, the API 400s, and every
        // turn after that fails too — bricking the chat until a page reload.
        if (!assistantCommitted) history.pop();
        inFlight = false;
        sendBtn!.disabled = false;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input!.value.trim();
      if (!value) return;
      input!.value = '';
      input!.style.height = 'auto';
      void send(value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form!.requestSubmit();
      }
    });
  }
</script>
